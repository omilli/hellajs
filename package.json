{
  "name": "hellajs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omilli/hellajs.git"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "audits": "bun ./scripts/audits.ts",
    "bench": "node ./scripts/bench.ts",
    "bundle": "node ./scripts/bundle.ts",
    "changeset": "changeset",
    "clean": "node ./scripts/clean.ts",
    "coverage": "node ./scripts/coverage.ts",
    "dead-exports": "node ./scripts/dead-exports.ts",
    "doc-links": "node ./scripts/doc-links.ts",
    "doc-snippets": "node ./scripts/doc-snippets.ts",
    "docs-ui": "node ./scripts/docs-ui.ts",
    "em-dash": "node ./scripts/em-dash.ts",
    "jsdoc-params": "node ./scripts/jsdoc-params.ts",
    "lint": "npx vp check && npm run lint:guards && npm run lint:structure",
    "lint:guards": "node ./scripts/type-visibility.ts && node ./scripts/dead-exports.ts && node ./scripts/jsdoc-params.ts && node ./scripts/doc-links.ts && node ./scripts/doc-structure.ts && node ./scripts/em-dash.ts",
    "lint:structure": "node ./scripts/doc-structure.ts",
    "memory": "bun ./scripts/memory.ts",
    "merge": "bun ./scripts/merge.ts",
    "release": "node ./scripts/bundle.ts --quiet && node ./scripts/release.ts",
    "visibility": "node ./scripts/type-visibility.ts",
    "worker": "bun ./scripts/worker.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@commitlint/types": "^20.5.0",
    "@hellajs/core": "*",
    "@hellajs/css": "*",
    "@hellajs/dom": "*",
    "@hellajs/resource": "*",
    "@hellajs/router": "*",
    "@hellajs/ssr": "*",
    "@hellajs/store": "*",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "5.0.4",
    "astro-plugin-hellajs": "*",
    "babel-plugin-hellajs": "*",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.14.5",
    "mitata": "^1.0.34",
    "playwright": "^1.62.1",
    "rollup-plugin-hellajs": "*",
    "terser": "^5.46.0",
    "vite-plugin-hellajs": "*",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "typescript": "~7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@12.0.2"
}
