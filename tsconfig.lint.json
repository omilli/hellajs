{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@utils/*": [
        "./utils/*"
      ],
      "@hellajs/core/*": [
        "./packages/core/lib/*"
      ],
      "@hellajs/dom/*": [
        "./packages/dom/lib/*"
      ],
      "@hellajs/css/*": [
        "./packages/css/lib/*"
      ],
      "@hellajs/resource/*": [
        "./packages/resource/lib/*"
      ],
      "@hellajs/router/*": [
        "./packages/router/lib/*"
      ],
      "@hellajs/store/*": [
        "./packages/store/lib/*"
      ]
    }
  },
  "include": [
    "packages/*/lib/**/*.ts",
    "packages/*/tests/**/*.ts",
    "plugins/*/src/**/*.mjs",
    "plugins/*/tests/**/*.ts",
    "scripts/**/*.ts",
    "scripts/utils/**/*.ts",
    "utils/**/*.js",
    "commitlint.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}