{
  "name": "js-framework-benchmark-hellajs",
  "private": true,
  "version": "1.0.0",
  "author": "omilli",
  "js-framework-benchmark": {
    "frameworkVersionFromPackage": "@hellajs/core",
    "frameworkHomeURL": "https://hellajs.com"
  },
  "scripts": {
    "bundle": "rollup -c rollup.config.mjs",
    "bundle:j": "rollup -c rollup.config.jsx.mjs",
    "bundle:t": "rollup -c rollup.config.ts.mjs",
    "bundle:all": "bun bundle:jsx && bun bundle:html && bun bundle:terser",
    "up": "bun bundle && bun index.html",
    "up:j": "bun bundle:j && bun index.html",
    "up:t": "bun bundle:t && bun index.html"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.59.0",
    "rollup-plugin-minify-template-literals": "^1.1.7"
  },
  "dependencies": {
    "@rollup/plugin-typescript": "^12.3.0"
  }
}