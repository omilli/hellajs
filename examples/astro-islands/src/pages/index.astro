---
import { css } from "@hellajs/css";
import Counter from '../components/Counter';
import MouseTracker from '../components/MouseTracker';
import NameSync from '../components/NameSync';

css({
  body: {
    fontFamily: "system-ui, sans-serif",
    maxWidth: "42rem",
    margin: "1rem auto",
    padding: "0 1rem",
  },
  "#name-input": {
    padding: "0.375rem 0.625rem",
    fontSize: "1rem",
    borderRadius: "0.375rem",
    border: "1px solid #d1d5db",
    marginTop: "1rem",
  },
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro Islands</title>
  </head>
  <body>
    <h1>Astro Islands</h1>

    <Counter client:load initial={0} />

    <MouseTracker client:only />

    <label for="name-input">Name</label>
    <input id="name-input" />
    <h1 id="greeting"></h1>

    <NameSync client:only />
  </body>
</html>
