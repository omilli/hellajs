---
import { css } from "@hellajs/css";
import Counter from '../components/Counter';
import MouseTracker from '../components/MouseTracker';
import NameSync from '../components/NameSync';

// Folded at build into the page's collected CSS: Astro delivers it as a
// page-scoped style tag in the head, so server-rendered markup is styled at
// first paint and none of these rules ship to the client.
css({
  body: {
    fontFamily: "system-ui, sans-serif",
    maxWidth: "42rem",
    margin: "2rem auto",
    padding: "0 1rem",
  },
  "#name-input": {
    padding: "0.375rem 0.625rem",
    fontSize: "1rem",
    borderRadius: "0.375rem",
    border: "1px solid #d1d5db",
  },
  "#greeting": {
    fontSize: "1.25rem",
    fontWeight: "600",
  },
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro Islands</title>
  </head>
  <body>
    <h1>Astro Islands</h1>

    <!-- Island 1: server-rendered JSX, adopted in place by hydrate() -->
    <Counter client:load initial={0} />

    <!-- Island 2: client-only html template, rendered fresh on the client -->
    <MouseTracker client:only="astro-hellajs" />

    <!-- Plain Astro-rendered HTML that island 3 binds to from the outside -->
    <label for="name-input">Name</label>
    <input id="name-input" value="World" />
    <p id="greeting"></p>

    <!-- Island 3: client-only $ref bindings into Astro's own HTML -->
    <NameSync client:only="astro-hellajs" />
  </body>
</html>
