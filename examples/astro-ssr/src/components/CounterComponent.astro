---
// Astro component with HellaJS SSR
import { ssr } from "@hellajs/dom";
import { Counter } from "./Counter";

interface Props {
  initial?: number;
}

const { initial = 0 } = Astro.props;

// Render component to HTML string on server
const html = ssr(Counter({ initial }));
---

<!-- Server-rendered HTML -->
<div id="counter" set:html={html} data-props={JSON.stringify({ initial })} />

<!-- Client-side hydration -->
<script>
  import { mount } from "@hellajs/dom";
  import { Counter } from "./Counter";

  const root = document.getElementById("counter")!;
  const props = JSON.parse(root.dataset.props!);

  mount(Counter(props), root);
</script>
