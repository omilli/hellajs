---
// Example Astro page using HellaJS SSR
import Layout from "../layouts/Layout.astro";
import CounterComponent from "../components/CounterComponent.astro";
---

<Layout title="HellaJS + Astro SSR">
  <main>
    <h1>HellaJS SSR with Astro</h1>

    <p>
      This counter is server-rendered using <code>ssr()</code> from @hellajs/dom,
      then hydrated on the client with full reactivity.
    </p>

    <section>
      <h2>Single Component Definition</h2>
      <p>
        The same <code>Counter</code> component renders on both server and client:
      </p>

      <CounterComponent initial={5} />
    </section>

    <section>
      <h2>How It Works</h2>
      <ol>
        <li>Server renders HTML with <code>ssr(Counter(props))</code></li>
        <li>Signals are evaluated once (no reactivity on server)</li>
        <li>Event handlers are skipped (client-only)</li>
        <li>Client mounts component with full reactivity</li>
      </ol>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  h1 {
    color: #1e293b;
    margin-bottom: 1rem;
  }

  section {
    margin: 2rem 0;
  }

  code {
    background: #f1f5f9;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: monospace;
  }

  ol {
    line-height: 1.8;
  }
</style>
