#!/bin/sh

# Only run sync if AGENTS.md files were changed in the last commit
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -q "AGENTS\.md"; then
  exit 0
fi

echo "AGENTS.md files changed, running sync..."

~/.bun/bin/bun run sync

if [ $? -ne 0 ]; then
  echo "Warning: Sync function failed but commit was successful"
  exit 0
fi

# Stage any sync-generated file changes
FILES_STAGED=false

if git diff --name-only | grep -q "CLAUDE\.md"; then
  find . -name "CLAUDE.md" -type f -exec git add {} + 2>/dev/null
  FILES_STAGED=true
fi

if git diff --name-only | grep -q "\.github/instructions"; then
  find .github/instructions -name "*.instructions.md" -type f -exec git add {} + 2>/dev/null
  FILES_STAGED=true
fi

if git diff --name-only | grep -q "\.github/copilot-instructions\.md"; then
  git add .github/copilot-instructions.md
  FILES_STAGED=true
fi

if [ "$FILES_STAGED" = true ] && git diff --cached --name-only | grep -q .; then
  git commit -m "chore: sync CLAUDE.md and instruction files from AGENTS.md" --no-verify
  echo "Auto-committed CLAUDE.md and instruction file updates"
fi

exit 0
