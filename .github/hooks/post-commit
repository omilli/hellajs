#!/bin/sh

# Only run sync if AGENTS.md files were changed in the last commit
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -q "AGENTS\.md"; then
  exit 0
fi

echo "AGENTS.md files changed, running sync..."

~/.bun/bin/bun run sync

if [ $? -ne 0 ]; then
  echo "Warning: Sync function failed but commit was successful"
  exit 0
fi

# Stage the closed set of sync-generated paths unconditionally — `git diff --name-only`
# misses untracked (newly-generated) files, which is how new .instructions.md fell through.
git add ':(glob)**/CLAUDE.md' .github/instructions/ .github/copilot-instructions.md 2>/dev/null

# Commit only if staging produced changes
if ! git diff --cached --quiet; then
  git commit -m "chore: sync CLAUDE.md and instruction files from AGENTS.md" --no-verify
  echo "Auto-committed CLAUDE.md and instruction file updates"
fi

exit 0
