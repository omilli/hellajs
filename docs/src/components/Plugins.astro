---
import { css } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import { Icon } from "astro-icon/components";

css({
  ".plugin-grid": {
    display: "grid",
    gridTemplateColumns: "1fr",
    marginBottom: "2rem",
    gap: "1.5rem"
  },

  ".plugin-card": {
    borderRadius: tokens.radius,
    display: "flex",
    textDecoration: "none",
  },

  ".plugin-card-body": {
    display: "flex",
    flexDirection: "column",
    gap: "0.5rem",
    padding: "1.5rem",
    width: "100%",
  },

  ".plugin-card-head": {
    alignItems: "center",
    display: "flex",
    gap: "0.5rem",
  },

  ".plugin-card-title": {
    fontSize: "1.125rem",
    fontWeight: "600",
  },

  ".plugin-card-desc": {
    fontSize: "0.875rem",
    opacity: "0.8",
  },

  ".plugin-card-cta": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.5)`,
    cursor: "pointer",
    display: "inline-flex",
    fontSize: "0.875rem",
    fontWeight: "600",
    height: "2rem",
    paddingInline: "0.75rem",
    transition: "transform 150ms ease",
  },

  // Patterns flavor: always-on shadow, tinted gradient, hover underline.
  ".plugin-card-shaded": {
    background: `linear-gradient(to right,
      color-mix(in srgb, ${tokens.primary} 10%, transparent),
      color-mix(in srgb, ${tokens.accent} 10%, transparent))`,
    border: `1px solid color-mix(in srgb, ${tokens.primary} 15%, transparent)`,
    boxShadow:
      "0 20px 25px -5px rgb(0 0 0 / 0.2), 0 8px 10px -6px rgb(0 0 0 / 0.2)",
    "&:hover .plugin-card-body": {
      textDecoration: "underline",
    },
  },

  // Plugins flavor: neutral until hover, then shadow + CTA grow.
  ".plugin-card-lift": {
    transition: "box-shadow 150ms ease",
    "&:hover": {
      boxShadow:
        "0 20px 25px -5px rgb(0 0 0 / 0.2), 0 8px 10px -6px rgb(0 0 0 / 0.2)",
    },
    "&:hover .plugin-card-cta": {
      transform: "scale(1.05)",
    },
  },

  "@media (min-width: 48rem)": {
    ".plugin-grid": {
      gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
    },
    ".pattern-grid": {
      gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
    },
  },

  "@media (min-width: 64rem)": {
    ".pattern-grid": {
      gridTemplateColumns: "repeat(3, minmax(0, 1fr))",
    },
  },
});

const plugins = [
  {
    name: "Babel",
    href: "/plugins/babel",
    icon: "simple-icons:babel",
    color: "#F9DC3E",
    description: "JSX support for HellaJS.",
    buttonTextColor: "#000"
  },
  {
    name: "Rollup",
    href: "/plugins/rollup",
    icon: "simple-icons:rollupdotjs",
    color: "#EC4A3F",
    description: "Tree-shaking output.",
    buttonTextColor: "#fff"
  },
  {
    name: "Vite",
    href: "/plugins/vite",
    icon: "simple-icons:vite",
    color: "#515cbd",
    description: "Lightning-fast development.",
    buttonTextColor: "#fff"
  },
  {
    name: "Astro",
    href: "/plugins/astro",
    icon: "simple-icons:astro",
    color: "#5f18ab",
    description: "HellaJS components in Astro.",
    buttonTextColor: "#fff"
  },
];
---

<div class="plugin-grid">
  {plugins.map((plugin) => (
    <a
      href={plugin.href}
      class="plugin-card plugin-card-lift"
      style={`background: linear-gradient(to bottom right, color-mix(in srgb, ${plugin.color} 10%, transparent), color-mix(in srgb, ${plugin.color} 5%, transparent)); border: 1px solid color-mix(in srgb, ${plugin.color} 30%, transparent);`}
    >
      <div class="plugin-card-body">
        <div class="plugin-card-head">
          <Icon name={plugin.icon} width={32} height={32} style={`color: ${plugin.color}`} />
          <h3 class="plugin-card-title">{plugin.name}</h3>
        </div>
        <p class="plugin-card-desc">{plugin.description}</p>
        <div>
          <span
            class="plugin-card-cta"
            style={`background-color: ${plugin.color}; color: ${plugin.buttonTextColor}`}
          >
            Get Started
          </span>
        </div>
      </div>
    </a>
  ))}
</div>
