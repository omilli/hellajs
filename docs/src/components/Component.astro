---
import { css } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import CodeExample from "./CodeExample.astro";
// `tokens.js`, not `tokens.dark.js`: its `.dark` class block carries the
// registry's default dark palette. `.demo-frame` keeps the `dark` class so
// that class-scoped declaration re-asserts values identical to `body.dark`'s
// on the frame - the frame renders the registry palette regardless of
// embedding scope. Portaled demo surfaces (dialogs, dropdowns, toasts)
// inherit the same default from `body.dark`; scope contract recorded in
// `../styles/tokens.ts`.
import "../components/ui/tokens.js";

css({
  ".demo-frame":{
    backgroundColor: tokens.background,
    border: `1px solid ${tokens.border}`,
    borderRadius: tokens.radius,
    color: tokens.foreground,
    marginBlock: "1.25rem",
    padding: "2rem",
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
  },
  ".demo-stack": {
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "1rem",
  },
  ".demo-row": {
    alignItems: "center",
    display: "flex",
    gap: "0.5rem",
    justifyContent: "center",
    flexWrap: "wrap"
  },
  ".demo-muted": {
    color: tokens.mutedForeground,
    fontSize: "0.875rem",
    margin: 0
  }
})

const {
  type = "stack",
  heading = "",
  Demo = () => {},
  code = ""
} = Astro.props;

let id = heading?.replaceAll(' ', '-').toLowerCase();
---
<h2 id={id}>{heading}</h2>

<slot/>

<!-- `not-prose`: opts the island out of the layout's prose typography — prose.ts excludes .not-prose subtrees (preflight supplies the zeroed base, registry classes own everything else). -->
<div class="demo-frame dark not-prose">
  <div class={`demo-${type}`}>
    {Demo}
  </div>
</div>

<CodeExample code={code || ""}/>
