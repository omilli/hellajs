---
import { css } from "@hellajs/css";
import CodeExample from "./CodeExample.astro";
// `tokens.js`, not `tokens.dark.js`: its `.dark` class block carries the
// registry's default dark palette. The demo frame below carries the `dark`
// class, so that class-scoped declaration re-asserts the default tokens on
// the frame and beats the site palette inherited from `html:root` - every
// surface outside the frame keeps the site theme. Portal-mounted demo
// surfaces (dialogs, dropdowns, toasts) escape to `body` and render in the
// site palette; scope contract recorded in `../styles/tokens.ts`.
import "@registry/theme/tokens.js";

css({
  ".demo-frame":{
    backgroundColor: "var(--background)",
    border: "1px solid var(--border)",
    borderRadius: "var(--radius)",
    color: "var(--foreground)",
    marginBlock: "1.25rem",
    padding: "2rem",
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
  },
  ".demo-stack": {
    alignItems: "center",
    display: "flex",
    flexDirection: "column",
    gap: "1rem",
  },
  ".demo-row": {
    alignItems: "center",
    display: "flex",
    gap: "0.5rem",
    justifyContent: "center",
    flexWrap: "wrap"
  },
  ".demo-muted": {
    color: "var(--muted-foreground)",
    fontSize: "0.875rem",
    margin: 0
  }
})

const {
  type = "stack",
  heading = "",
  Demo = () => {},
  code = ""
} = Astro.props;

let id = heading?.replaceAll(' ', '-').toLowerCase();
---
<h2 id={id}>{heading}</h2>

<slot/>

<!-- `not-prose`: opts the island out of the layout's prose typography — prose.ts excludes .not-prose subtrees (preflight supplies the zeroed base, registry classes own everything else). -->
<div class="demo-frame dark not-prose">
  <div class={`demo-${type}`}>
    {Demo}
  </div>
</div>

<CodeExample code={code || ""}/>
