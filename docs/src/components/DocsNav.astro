---
/**
 * Docs left navigation — server-rendered, zero client JS. The item look
 * comes from the shared menu vocabulary in ../styles/menu (`.site-menu-link`;
 * the registry's built output keeps style constants module-private, so the
 * copies are docs-owned); groups and the rail/drawer shell are inlined
 * below. Active route is computed at build time from Astro.url.pathname;
 * the mobile drawer is the layout's checkbox + this aside (the sibling
 * rules below own the mechanics). Replaces the daisyUI Sidebar.astro/
 * NavItem.astro pair; the URL map is docs/src/nav.ts, whose tree is
 * unchanged — only the transform moved here.
 *
 * The menu import lives in the layouts, not here: a css-bearing module in
 * a component's import graph rides the plugin's per-instance island splice
 * (duplicated on every render), while layout-imported sheets register once
 * into the deterministic cssText head.
 */
import NavNode from "./NavNode.astro";
import { css } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import {
  navigation,
  type NavEntry,
  type NavSection,
  type NavTreeNode,
} from "../nav";

css({
  // Left nav: off-canvas drawer on mobile, fixed rail on desktop. Drawer
  // mechanics: the layout's hidden checkbox + Navbar's label[for]; sibling
  // selectors reach this aside because it follows the checkbox in body.
  ".site-nav": {
    background: tokens.sidebar,
    color: tokens.sidebarForeground,
    insetBlock: "0",
    left: "0",
    overflowY: "auto",
    position: "fixed",
    transform: "translateX(-100%)",
    transition: "transform 200ms ease",
    width: tokens.navW,
    zIndex: "40",
    "& > nav": { paddingBlock: "1rem", paddingInline: "0.5rem" },
    "& details": { marginTop: "0.75rem" },
    "@media (min-width: 64rem)": {
      "&": { transform: "none", top: tokens.navbarH },
    },
  },

  // Drawer open: the checkbox state is the subject (the compiler substitutes
  // only a LEADING `&`), so the sibling rule sits at the top level.
  "#nav-drawer:checked ~ .site-nav": { transform: "none" },

  // Group disclosure row — registry sidebar groupLabel values plus the
  // pointer/marker behavior a summary needs; the parent-of-active highlight
  // has no registry hook (groupLabel carries no [data-active] rule), so
  // this owns it.
  ".site-nav-group-label": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    color: `color-mix(in oklab, ${tokens.sidebarForeground} 70%, transparent)`,
    cursor: "pointer",
    display: "flex",
    flexShrink: "0",
    fontSize: "0.75rem",
    fontWeight: "500",
    height: "2rem",
    lineHeight: "1rem",
    listStyle: "none",
    paddingInline: "0.5rem",
    width: "100%",
    "&::-webkit-details-marker": { display: "none" },
    "&[data-active='true']": { color: tokens.primary },
  },

  // Nested group list — registry sidebar menuSub values.
  ".site-nav-sub": {
    borderLeft: `1px solid ${tokens.sidebarBorder}`,
    marginInline: "0.875rem",
    paddingBlock: "0.125rem",
    paddingInline: "0.625rem",
    translate: "1px",
  },

  // Mobile-only main-nav links list above the section tree; the bottom
  // border is the divider the daisy menu's hr used to draw.
  ".mobile-only": {
    borderBottom: `1px solid ${tokens.sidebarBorder}`,
    marginBottom: "0.5rem",
    paddingBottom: "0.5rem",
    "@media (min-width: 64rem)": {
      "&": { display: "none" },
    },
  },
});

const { pathname: rawPathname } = Astro.props as { pathname: string };

// Astro.url.pathname carries the directory format's trailing slash at build
// time; the nav tree's urls don't. Normalize once here — every consumer
// (exact-match leaf/group highlighting, startsWith section links) keys off
// the stripped value. (The daisy-era nav compared raw and never matched —
// the old build's nav links carry aria-current="false" throughout.)
const pathname = rawPathname.replace(/\/+$/, "") || "/";

const allDocs = Object.values(
  import.meta.glob<Record<string, any>>("../pages/**/*.mdx", {
    eager: true,
  }),
);

const getSection = (path: string): NavSection | null => {
  if (path.startsWith("/learn")) return "learn";
  if (path.startsWith("/ui")) return "ui";
  if (path.startsWith("/headless")) return "headless";
  if (path.startsWith("/reference")) return "reference";
  if (path.startsWith("/plugins")) return "plugins";
  return null;
};

// Directories that hold real pages. A nav group prefixes its children only
// when its folder URL is one of these (learn/concepts); otherwise the group
// renders as a pure heading and children keep the section root (ui's flat
// component pages).
const pageDirs = new Set(
  allDocs.map((doc) => {
    const parts = (doc.url ?? "").split("/").filter(Boolean);
    return `/${parts.slice(0, -1).join("/")}`;
  }),
);

const transformNav = (nav: NavEntry[], basePath = ""): NavTreeNode[] =>
  nav.map((item) => {
    // Custom label entry: { label: "display text", slug: "url-slug" }
    if (typeof item === "object" && "label" in item && "slug" in item) {
      const url = `${basePath}/${item.slug}`;
      const doc = allDocs.find((d) => d.url === url);
      const title = doc?.frontmatter?.title || item.label;
      return { title, url };
    }

    // String entry: simple navigation item
    if (typeof item === "string") {
      const url = `${basePath}/${item.toLowerCase()}`;
      const doc = allDocs.find((d) => d.url === url);
      const title = doc?.frontmatter?.title || item.replace(/-/g, " ");
      return { title, url };
    }

    // Folder/group entry: { folderName: children[] }
    const [folderName, children] = Object.entries(item)[0]!;
    const url = `${basePath}/${folderName.toLowerCase()}`;
    const doc = allDocs.find((d) => d.url === url);
    const title = doc?.frontmatter?.title || folderName.replace(/-/g, " ");
    const childBase = pageDirs.has(url) ? url : basePath;
    return { title, children: transformNav(children, childBase) };
  });

const section = getSection(pathname);
const sectionNodes = transformNav(
  navigation[section ?? "learn"],
  `/${section ?? "learn"}`,
);

const mainNavLinks = [
  { label: "Learn", root: "/learn" },
  { label: "API Reference", root: "/reference" },
  { label: "Plugins", root: "/plugins" },
  { label: "Headless", root: "/headless" },
  { label: "UI", root: "/ui" },
];
---

<aside class="site-nav" aria-label="Docs navigation">
  <nav>
    <ul class="site-menu mobile-only">
      {
        mainNavLinks.map((link) => (
          <li>
            <a
              href={link.root}
              class="site-menu-link"
              data-active={pathname.startsWith(link.root) ? "true" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="site-menu">
      {sectionNodes.map((node) => <NavNode node={node} pathname={pathname} />)}
    </ul>
  </nav>
</aside>
