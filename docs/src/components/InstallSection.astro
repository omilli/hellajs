---
import { highlight } from "../utils/highlight";

interface Props {
  entry: string;
}

const { entry } = Astro.props;

// All four variants are real `add`-output files written by `bun
// install-sources` — the Manual tab shows exactly what the CLI writes, as
// real greppable files, with no ui-package import anywhere in site code.
const cssJsx = import.meta.glob("../generated/install/css-jsx/*.tsx", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const cssHtml = import.meta.glob("../generated/install/css-html/*.ts", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const tailwindJsx = import.meta.glob("../generated/install/tailwind-jsx/*.tsx", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const tailwindHtml = import.meta.glob("../generated/install/tailwind-html/*.ts", { query: "?raw", import: "default", eager: true }) as Record<string, string>;

const sourceMaps: Record<string, Record<string, string>> = {
  "css-jsx": cssJsx,
  "css-html": cssHtml,
  "tailwind-jsx": tailwindJsx,
  "tailwind-html": tailwindHtml,
};
const sourceKeys: Record<string, string> = {
  "css-jsx": `../generated/install/css-jsx/${entry}.tsx`,
  "css-html": `../generated/install/css-html/${entry}.ts`,
  "tailwind-jsx": `../generated/install/tailwind-jsx/${entry}.tsx`,
  "tailwind-html": `../generated/install/tailwind-html/${entry}.ts`,
};

// Vite normalizes glob keys relative to this file, so match by anchored
// suffix instead of assuming a literal key.
const sources: Record<string, string> = {};
for (const [variant, key] of Object.entries(sourceKeys)) {
  const match = Object.entries(sourceMaps[variant]).find(([file]) => file.endsWith(key));
  if (match === undefined) {
    throw new Error(`[InstallSection] missing ${variant} install source for ${entry}; generate with: bun install-sources ${entry}`);
  }
  sources[variant] = match[1];
}

const langs: Record<string, string> = { "css-jsx": "tsx", "css-html": "ts", "tailwind-jsx": "tsx", "tailwind-html": "ts" };
const highlighted: Record<string, string> = {};
for (const [key, code] of Object.entries(sources)) {
  highlighted[key] = await highlight(code, langs[key] ?? "ts");
}

const commandBlock = await highlight(
  `npx @hellajs/ui add ${entry}\n# bunx @hellajs/ui add ${entry}\n# pnpm dlx @hellajs/ui add ${entry}`,
  "bash",
);
---

<section class="install-section" data-install>
  <h2>Installation</h2>
  <div class="install-tabs">
    <button type="button" class="install-tab is-active" data-install-tab="command">Command</button>
    <button type="button" class="install-tab" data-install-tab="manual">Manual</button>
  </div>
  <div class="install-panel" data-install-panel="command">
    <div class="install-code" set:html={commandBlock} />
  </div>
  <div class="install-panel" data-install-panel="manual" hidden>
    <div class="install-pickers">
      <div class="install-picker" role="group" aria-label="Style">
        <button type="button" class="install-pick is-active" data-pick-style="css">css</button>
        <button type="button" class="install-pick" data-pick-style="tailwind">tailwind</button>
      </div>
      <div class="install-picker" role="group" aria-label="Format">
        <button type="button" class="install-pick is-active" data-pick-format="jsx">jsx</button>
        <button type="button" class="install-pick" data-pick-format="html">html</button>
      </div>
    </div>
    <div class="install-source-frame">
      <template data-install-template="css-jsx"><div class="install-code" set:html={highlighted["css-jsx"]} /></template>
      <template data-install-template="css-html"><div class="install-code" set:html={highlighted["css-html"]} /></template>
      <template data-install-template="tailwind-jsx"><div class="install-code" set:html={highlighted["tailwind-jsx"]} /></template>
      <template data-install-template="tailwind-html"><div class="install-code" set:html={highlighted["tailwind-html"]} /></template>
      <div class="install-code" data-install-live />
      <button type="button" class="install-copy" data-install-copy>Copy</button>
    </div>
  </div>
</section>

<style is:global>
  .install-section {
    margin-block: 2rem;
  }
  .install-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-slate-700);
    margin-bottom: 1rem;
  }
  .install-tab {
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .install-tab.is-active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }
  .install-pickers {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .install-picker {
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--color-slate-700);
    border-radius: var(--radius);
    padding: 0.2rem;
  }
  .install-pick {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    border-radius: calc(var(--radius) * 0.6);
    color: var(--muted-foreground);
  }
  .install-pick.is-active {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }
  .install-source-frame {
    position: relative;
  }
  .install-code pre {
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-slate-700);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .install-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    border: 1px solid var(--color-slate-700);
    border-radius: calc(var(--radius) * 0.6);
    background-color: var(--color-base-50);
    color: var(--primary);
  }
</style>

<script>
  // Tab and picker state is data-attribute swapping of pre-rendered blocks;
  // nothing async at runtime. Astro dedupes this module script per page, so
  // it wires every [data-install] section on the document.
  function wireInstallSection(section: Element): void {
    const tabs = Array.from(section.querySelectorAll("[data-install-tab]"));
    const panels = Array.from(section.querySelectorAll("[data-install-panel]"));
    const stylePicks = Array.from(section.querySelectorAll("[data-pick-style]"));
    const formatPicks = Array.from(section.querySelectorAll("[data-pick-format]"));
    const liveSlot = section.querySelector("[data-install-live]");
    const copyButton = section.querySelector("[data-install-copy]");
    let style = "css";
    let format = "jsx";

    // The four variants render as inert <template>s; the live slot holds the
    // one clone matching the picker state — three of four never enter layout.
    const syncSource = () => {
      if (!liveSlot) return;
      liveSlot.replaceChildren();
      const template = section.querySelector<HTMLTemplateElement>(`template[data-install-template="${style}-${format}"]`);
      if (template) {
        liveSlot.appendChild(template.content.cloneNode(true));
      }
    };
    const syncPicks = (picks: Element[], attr: string, value: string) => {
      picks.forEach((pick) => {
        pick.classList.toggle("is-active", pick.getAttribute(attr) === value);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-install-tab");
        tabs.forEach((other) => other.classList.toggle("is-active", other === tab));
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-install-panel") !== key;
        });
      });
    });
    stylePicks.forEach((pick) => {
      pick.addEventListener("click", () => {
        style = pick.getAttribute("data-pick-style") ?? "css";
        syncPicks(stylePicks, "data-pick-style", style);
        syncSource();
      });
    });
    formatPicks.forEach((pick) => {
      pick.addEventListener("click", () => {
        format = pick.getAttribute("data-pick-format") ?? "jsx";
        syncPicks(formatPicks, "data-pick-format", format);
        syncSource();
      });
    });
    copyButton?.addEventListener("click", () => {
      const code = liveSlot?.querySelector("pre")?.textContent ?? "";
      navigator.clipboard.writeText(code).then(() => {
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1500);
      });
    });
    syncSource();
  }

  const init = () => {
    document.querySelectorAll("[data-install]").forEach(wireInstallSection);
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
