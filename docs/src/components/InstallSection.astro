---
import { readFileSync } from "node:fs";
import { codeToHtml } from "shiki";

interface Props {
  entry: string;
}

const { entry } = Astro.props;

// The four style x format texts are vendored `add` output, generated by
// docs/scripts/gen-install-sources.ts through the public addComponent API —
// the Manual tab shows what `add` writes by construction. Site code imports
// nothing from the ui package.
const sources: Record<string, string> = JSON.parse(
  readFileSync(`src/generated/install/${entry}.json`, "utf8"),
);

// Zero-drift gate: the site's vendored components ARE the css+html `add`
// output (ui's drift test pins it); a regen that diverges the generated text
// from the vendored file must fail the build here too.
if (entry === "accordion") {
  const vendored = readFileSync(`src/components/ui/${entry}.ts`, "utf8");
  if (sources["css-html"] !== vendored) {
    throw new Error(
      `[InstallSection] docs/src/generated/install/${entry}.json css-html drifted from docs/src/components/ui/${entry}.ts; regenerate with: bun docs/scripts/gen-install-sources.ts ${entry}`,
    );
  }
}

const langs: Record<string, string> = { "css-jsx": "tsx", "css-html": "ts", "tailwind-jsx": "tsx", "tailwind-html": "ts" };
const highlighted: Record<string, string> = {};
for (const [key, code] of Object.entries(sources)) {
  highlighted[key] = await codeToHtml(code, { lang: langs[key] ?? "ts", theme: "github-dark" });
}

const commandBlock = await codeToHtml(
  `npx @hellajs/ui add ${entry}\n# bunx @hellajs/ui add ${entry}\n# pnpm dlx @hellajs/ui add ${entry}`,
  { lang: "bash", theme: "github-dark" },
);
---

<section class="install-section" data-install>
  <h2>Installation</h2>
  <div class="install-tabs">
    <button type="button" class="install-tab is-active" data-install-tab="command">Command</button>
    <button type="button" class="install-tab" data-install-tab="manual">Manual</button>
  </div>
  <div class="install-panel" data-install-panel="command">
    <div class="install-code" set:html={commandBlock} />
  </div>
  <div class="install-panel" data-install-panel="manual" hidden>
    <div class="install-pickers">
      <div class="install-picker" role="group" aria-label="Style">
        <button type="button" class="install-pick is-active" data-pick-style="css">css</button>
        <button type="button" class="install-pick" data-pick-style="tailwind">tailwind</button>
      </div>
      <div class="install-picker" role="group" aria-label="Format">
        <button type="button" class="install-pick is-active" data-pick-format="jsx">jsx</button>
        <button type="button" class="install-pick" data-pick-format="html">html</button>
      </div>
    </div>
    <div class="install-source-frame">
      {Object.entries(highlighted).map(([key, code]) => (
        <div class="install-code" data-install-source={key} hidden={key !== "css-jsx"} set:html={code} />
      ))}
      <button type="button" class="install-copy" data-install-copy>Copy</button>
    </div>
    <script type="application/json" data-install-sources set:html={JSON.stringify(sources)} />
  </div>
</section>

<style is:global>
  .install-section {
    margin-block: 2rem;
  }
  .install-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-slate-700);
    margin-bottom: 1rem;
  }
  .install-tab {
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .install-tab.is-active {
    color: var(--primary-foreground);
    border-bottom-color: var(--primary-foreground);
  }
  .install-pickers {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .install-picker {
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--color-slate-700);
    border-radius: var(--radius);
    padding: 0.2rem;
  }
  .install-pick {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    border-radius: calc(var(--radius) * 0.6);
    color: var(--muted-foreground);
  }
  .install-pick.is-active {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
  }
  .install-source-frame {
    position: relative;
  }
  .install-code pre {
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-slate-700);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .install-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    border: 1px solid var(--color-slate-700);
    border-radius: calc(var(--radius) * 0.6);
    background-color: var(--color-base-50);
    color: var(--secondary);
  }
</style>

<script>
  // Tab and picker state is data-attribute swapping of pre-rendered blocks;
  // nothing async at runtime. Astro dedupes this module script per page, so
  // it wires every [data-install] section on the document.
  function wireInstallSection(section: Element): void {
    const tabs = Array.from(section.querySelectorAll("[data-install-tab]"));
    const panels = Array.from(section.querySelectorAll("[data-install-panel]"));
    const stylePicks = Array.from(section.querySelectorAll("[data-pick-style]"));
    const formatPicks = Array.from(section.querySelectorAll("[data-pick-format]"));
    const sourceBlocks = Array.from(section.querySelectorAll("[data-install-source]"));
    const copyButton = section.querySelector("[data-install-copy]");
    const sourcesNode = section.querySelector("[data-install-sources]");
    const sources = JSON.parse(sourcesNode?.textContent ?? "{}") as Record<string, string>;
    let style = "css";
    let format = "jsx";

    const syncSource = () => {
      const key = `${style}-${format}`;
      sourceBlocks.forEach((block) => {
        block.hidden = block.getAttribute("data-install-source") !== key;
      });
    };
    const syncPicks = (picks: Element[], attr: string, value: string) => {
      picks.forEach((pick) => {
        pick.classList.toggle("is-active", pick.getAttribute(attr) === value);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.getAttribute("data-install-tab");
        tabs.forEach((other) => other.classList.toggle("is-active", other === tab));
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-install-panel") !== key;
        });
      });
    });
    stylePicks.forEach((pick) => {
      pick.addEventListener("click", () => {
        style = pick.getAttribute("data-pick-style") ?? "css";
        syncPicks(stylePicks, "data-pick-style", style);
        syncSource();
      });
    });
    formatPicks.forEach((pick) => {
      pick.addEventListener("click", () => {
        format = pick.getAttribute("data-pick-format") ?? "jsx";
        syncPicks(formatPicks, "data-pick-format", format);
        syncSource();
      });
    });
    copyButton?.addEventListener("click", () => {
      navigator.clipboard.writeText(sources[`${style}-${format}`] ?? "").then(() => {
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1500);
      });
    });
  }

  const init = () => {
    document.querySelectorAll("[data-install]").forEach(wireInstallSection);
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
