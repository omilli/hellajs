---
import { css } from "@hellajs/css";

// npm version shields on the reference/ui index pages. Prose gives
// `main img` 2em margins; badges opt back out.
css({
  ".pkg-badge-row": {
    display: "flex",
    gap: "0.5rem",
    "& img": {
      display: "block",
      marginBlock: "0",
    },
  },
});

const { package: pack } = Astro.props as {
  package: string;
};
---

<div class="pkg-badge-row">
  <a href={`https://www.npmjs.com/package/@hellajs/${pack}`}>
    <img
      src={`https://img.shields.io/npm/v/@hellajs/${pack}?color=orange`}
      alt={`Version of @hellajs/${pack}`}
    />
  </a>
</div>
