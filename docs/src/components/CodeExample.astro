---
import { css } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import { exampleCode } from "../utils/example-code";

interface Props {
  /** Function name of the demo export whose source the card shows. */
  code: string;
}

// github-dark's canvas: shiki inlines this on the pre, so the fade gradient
// must reuse the same literal to blend in. theme="github-dark" pins it
// (matches InstallSection's Code blocks).
const codeBg = "#24292e";

css({
  ".view-code": {
    marginTop: "0.5rem",
    position: "relative",
    border: `1px solid ${tokens.border}`,
    borderRadius: tokens.radius,
    overflow: "hidden",
    ".code-scroll": {
      // Collapsed preview: ~5 crisp lines, the rest behind the fade.
      // .is-open lifts the cap; .is-fit (JS-measured, source fits the cap)
      // drops the fade/toggle chrome and restores the tight padding.
      maxHeight: "10.5rem",
      overflow: "hidden",
      position: "relative",
    },
    "pre.astro-code": {
      // Bottom padding leaves a lane for the floating toggle so expanded
      // code never sits under it (shadcn's expand-button pattern).
      padding: "1rem 1rem 3.5rem",
      border: 0,
      borderRadius: 0,
      margin: 0,
      overflowX: "auto",
      fontSize: "0.8125rem",
      lineHeight: 1.5,
    },
    ".code-fade": {
      position: "absolute",
      inset: "auto 0 0 0",
      height: "4rem",
      background: `linear-gradient(to bottom, transparent, ${codeBg})`,
      pointerEvents: "none",
    },
    // Shared floating-chip chrome, solid like InstallSection's .install-copy
    // (base50 over the code canvas, near-white text). The comma group needs
    // no & repetition: css() composes every part against the parent selector
    // (parts carrying & substitute it, bare parts become descendants). No
    // nested & keys under the group, though — & substitution under a comma
    // parent is literal, so a nested &:hover would pin the state to the last
    // part; state keys like &:hover belong inside the per-element rules below.
    "& .code-copy, & .code-toggle": {
      position: "absolute",
      display: "inline-flex",
      alignItems: "center",
      gap: "0.375rem",
      backgroundColor: tokens.base50,
      border: `1px solid ${tokens.border}`,
      borderRadius: `calc(${tokens.radius} * 0.6)`,
      color: tokens.foreground,
      cursor: "pointer",
      fontFamily: tokens.fontSans,
      fontSize: "0.75rem",
      fontWeight: 500,
      padding: "0.3rem 0.625rem",
    },
    ".code-copy": {
      top: "0.5rem",
      right: "0.5rem",
      "&:hover": { color: tokens.primary },
      ".copy-done": { display: "none" },
      "&.is-copied": {
        ".copy-idle": { display: "none" },
        ".copy-done": { display: "inline-flex" },
      },
    },
    ".code-toggle": {
      bottom: "0.75rem",
      left: "50%",
      transform: "translateX(-50%)",
      "&:hover": { color: tokens.primary },
      "& svg": { transition: "transform 150ms ease" },
    },
    // Card state blocks: .is-open expands, .is-fit short-circuits the
    // collapse chrome for sources that fit the cap.
    "&.is-open": {
      ".code-scroll": { maxHeight: "none" },
      ".code-fade": { display: "none" },
      ".code-toggle svg": { transform: "rotate(180deg)" },
    },
    "&.is-fit": {
      "pre.astro-code": { paddingBottom: "1rem" },
      ".code-fade": { display: "none" },
      ".code-toggle": { display: "none" },
    },
  }
})

const { code } = Astro.props;
// The page's URL names both the page and its demo module (ui/button →
// demos/button-demo.tsx, headless/accordion → demos/headless/
// accordion-demo.tsx — headless slugs collide with ui demo names, so they
// namespace under "headless/"); exampleCode throws loudly on a mismatch
// instead of rendering an empty card.
const segments = Astro.url.pathname.split("/").filter(Boolean);
const last = segments.at(-1) ?? "";
const demo = segments[0] === "headless" ? `headless/${last}` : last;
const scrollId = `code-scroll-${crypto.randomUUID().slice(0, 8)}`;
---

<div class="view-code" data-code-card>
  <div class="code-scroll" id={scrollId} data-code-scroll>
    <Code code={exampleCode(demo, code)} lang={"tsx"} theme="github-dark" />
    <div class="code-fade" aria-hidden="true"></div>
  </div>
  <button type="button" class="code-copy" data-code-copy aria-label="Copy code">
    <span class="copy-idle"><Icon name="ph:copy-simple" width={15} height={15} /></span>
    <span class="copy-done"><Icon name="ph:check" width={15} height={15} /></span>
  </button>
  <button
    type="button"
    class="code-toggle"
    data-code-toggle
    aria-expanded="false"
    aria-controls={scrollId}
  >
    <span data-toggle-label>View Code</span>
    <Icon name="ph:caret-down" width={14} height={14} />
  </button>
</div>

<script>
  // Astro dedupes this module script per page, so one listener set wires
  // every [data-code-card] on the document (ui pages stack several). Same
  // readyState dance as InstallSection.
  function wireCodeCard(card: Element): void {
    const scroll = card.querySelector<HTMLElement>("[data-code-scroll]");
    const toggle = card.querySelector<HTMLButtonElement>(
      "[data-code-toggle]",
    );
    const label = toggle?.querySelector<HTMLElement>("[data-toggle-label]");
    const copy = card.querySelector<HTMLButtonElement>("[data-code-copy]");

    // Source fits inside the collapsed cap: nothing is clipped, so the fade
    // and the toggle button would be pure noise. clientHeight is the cap
    // (overflow hidden); scrollHeight is the content. The monospace stack
    // is system fonts, so this measurement cannot go stale after load.
    if (scroll && scroll.scrollHeight <= scroll.clientHeight + 1) {
      card.classList.add("is-fit");
    }

    toggle?.addEventListener("click", () => {
      const open = card.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      if (label) {
        label.textContent = open ? "Hide Code" : "View Code";
      }
    });

    copy?.addEventListener("click", () => {
      const code = card.querySelector("pre")?.textContent ?? "";
      navigator.clipboard.writeText(code).then(() => {
        copy.classList.add("is-copied");
        window.setTimeout(() => {
          copy.classList.remove("is-copied");
        }, 1500);
      });
    });
  }

  const init = () => {
    document.querySelectorAll("[data-code-card]").forEach(wireCodeCard);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
