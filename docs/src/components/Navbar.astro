---
/**
 * Top bar — static server-rendered chrome, zero client JS, replacing the
 * daisyUI Navbar.astro (deleted). Site-owned bar on its own css vocabulary,
 * inlined below: logo, section links (active computed at build with the same
 * trailing-slash normalization DocsNav applies), a search trigger button
 * (opens the SearchPalette island via the data-command-open hook; the island
 * owns the ⌘K/Ctrl+K shortcut), GitHub link, and the drawer toggle (the
 * label[for] + .sidebar-hamburger/.sidebar-close pair the body:has swap below
 * flips on the layout's checkbox). Sections collapse into the drawer below
 * lg (64rem); the trigger collapses to an icon button. The close-icon base
 * rule (`display: none` inside the toggle) replaces the tailwind `hidden`
 * utility the daisy-era markup leaned on; the body:has swap that follows
 * outranks it by specificity.
 */
import { css } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import { Icon } from "astro-icon/components";

css({
  ".site-topbar": {
    alignItems: "center",
    background: tokens.base300,
    display: "flex",
    gap: "1rem",
    height: tokens.navbarH,
    left: "0",
    paddingInline: "1rem",
    position: "fixed",
    right: "0",
    top: "0",
    zIndex: "50",
    "@media (min-width: 64rem)": {
      "&": { paddingInline: "1.5rem" },
    },
  },

  ".site-logo": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    display: "flex",
    flexShrink: "0",
    height: "2.5rem",
    "& img": { height: "2rem", width: "2rem" },
    "&:focus-visible": { boxShadow: `0 0 0 2px ${tokens.ring}` },
  },

  ".site-topbar-links": {
    display: "none",
    gap: "0.25rem",
    "@media (min-width: 64rem)": {
      "&": { display: "flex" },
    },
  },

  ".site-topbar-link": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    color: `color-mix(in oklab, ${tokens.foreground} 70%, transparent)`,
    display: "flex",
    fontSize: "0.875rem",
    fontWeight: "500",
    height: "2rem",
    paddingInline: "0.75rem",
    "&:hover": {
      backgroundColor: tokens.base50,
      color: tokens.foreground,
    },
    "&:focus-visible": { boxShadow: `0 0 0 2px ${tokens.ring}` },
    "&[data-active='true']": { color: tokens.primary, fontWeight: "700" },
  },

  ".site-topbar-actions": {
    alignItems: "center",
    display: "flex",
    flex: "1",
    gap: "0.25rem",
    justifyContent: "flex-end",
    marginLeft: "auto",
  },

  // Input-affordance button (opens the palette); ⌘K hint hides with the
  // label below lg. kbd values re-declare the registry kbd module's base
  // (packages/ui/registry/kbd/kbd-css.ts) — static chrome cannot import
  // registry constants.
  ".site-search-trigger": {
    alignItems: "center",
    background: tokens.base200,
    border: `1px solid ${tokens.sidebarBorder}`,
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    color: tokens.mutedForeground,
    cursor: "pointer",
    display: "flex",
    fontSize: "0.875rem",
    gap: "0.5rem",
    height: "2.25rem",
    paddingInline: "0.625rem",
    width: "16rem",
    "& svg": { flexShrink: "0", height: "1rem", width: "1rem" },
    "&:hover": { borderColor: tokens.input, color: tokens.foreground },
    "&:focus-visible": { boxShadow: `0 0 0 2px ${tokens.ring}` },
    "@media (max-width: 63.99rem)": {
      "&": { paddingInline: "0", width: "2.25rem", justifyContent: "center" },
      "& .site-search-label, & .site-search-kbd": { display: "none" },
    },
  },

  ".site-search-kbd": {
    alignItems: "center",
    border: `1px solid ${tokens.border}`,
    borderRadius: `calc(${tokens.radius} * 0.5)`,
    color: tokens.mutedForeground,
    display: "flex",
    fontFamily: tokens.fontSans,
    fontSize: "0.75rem",
    fontWeight: "500",
    height: "1.25rem",
    justifyContent: "center",
    lineHeight: "1rem",
    marginLeft: "auto",
    paddingInline: "0.25rem",
    pointerEvents: "none",
    userSelect: "none",
  },

  ".site-icon-link": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    color: `color-mix(in oklab, ${tokens.foreground} 70%, transparent)`,
    display: "flex",
    height: "2.25rem",
    justifyContent: "center",
    width: "2.25rem",
    "&:hover": {
      backgroundColor: tokens.base50,
      color: tokens.foreground,
    },
    "&:focus-visible": { boxShadow: `0 0 0 2px ${tokens.ring}` },
    "& svg": { height: "1.25rem", width: "1.25rem" },
  },

  ".site-drawer-toggle": {
    alignItems: "center",
    borderRadius: `calc(${tokens.radius} * 0.8)`,
    color: `color-mix(in oklab, ${tokens.foreground} 70%, transparent)`,
    cursor: "pointer",
    display: "flex",
    height: "2.25rem",
    justifyContent: "center",
    width: "2.25rem",
    "&:hover": {
      backgroundColor: tokens.base50,
      color: tokens.foreground,
    },
    "&:focus-visible": { boxShadow: `0 0 0 2px ${tokens.ring}` },
    "& svg": { height: "1.25rem", width: "1.25rem" },
    "& .sidebar-close": { display: "none" },
    "@media (min-width: 64rem)": {
      "&": { display: "none" },
    },
  },

  // Hamburger/close swap on the drawer icons (moved from the daisy-era
  // rules the deleted Sidebar.astro owned). The checkbox state is the
  // subject; sibling surfaces live in other components, so this reaches
  // them from body scope.
  "body:has(#nav-drawer:checked)": {
    "& .sidebar-hamburger": { display: "none" },
    "& .sidebar-close": { display: "block" },
  },
});

const { pathname: rawPathname } = Astro.url;
const pathname = rawPathname.replace(/\/+$/, "") || "/";

const links = [
  { root: "/learn", label: "Learn" },
  { root: "/reference", label: "API Reference" },
  { root: "/plugins", label: "Plugins" },
  { root: "/ui", label: "UI" },
];
---

<header class="site-topbar">
  <a href="/" class="site-logo" aria-label="HellaJS home">
    <img src="/favicon.svg" alt="" width="32" height="32" />
  </a>
  <nav class="site-topbar-links" aria-label="Sections">
    {
      links.map((link) => (
        <a
          href={link.root}
          class="site-topbar-link"
          data-active={
            pathname === link.root || pathname.startsWith(`${link.root}/`)
              ? "true"
              : undefined
          }
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="site-topbar-actions">
    <button
      type="button"
      class="site-search-trigger"
      data-command-open
      aria-label="Search the docs"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.34-4.34"></path>
      </svg>
      <span class="site-search-label">Search…</span>
      <kbd class="site-search-kbd" aria-hidden="true">⌘K</kbd>
    </button>
    <a
      href="https://github.com/omilli/hellajs"
      class="site-icon-link"
      aria-label="GitHub repository"
    >
      <Icon name="ph:github-logo" width={20} height={20} />
    </a>
    <label for="nav-drawer" class="site-drawer-toggle" aria-label="Toggle navigation">
      <svg
        class="sidebar-hamburger"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        class="sidebar-close"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </label>
  </div>
</header>
