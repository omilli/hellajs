---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ButtonGroupContent from "@ui/concepts/button-group.mdx";
import Component from "../../components/Component.astro";

import { ButtonGroupDemo, ButtonGroupPlateDemo, ButtonGroupVerticalDemo } from "../../demos/button-group-demo";

const title = "Button Group";
const description = "Interactive Button Group demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Button Group</h1>
  <p>A flex container that joins buttons, inputs, and text into one visual control: inner edges are rounded and de-bordered so a row or column of separate elements reads as a single widget.</p>

  <InstallSection entry="button-group" />

  <Component type="row" heading="Playground" Demo={<ButtonGroupDemo client:load />} code="ButtonGroupDemo"/>
  <Component type="row" heading="Text plate" Demo={<ButtonGroupPlateDemo />} code="ButtonGroupPlateDemo">
    <p>ButtonGroupText renders the muted prefix plate; compose it with your own input copy.</p>
  </Component>
  <Component type="row" heading="Vertical orientation" Demo={<ButtonGroupVerticalDemo />} code="ButtonGroupVerticalDemo">
    <p>Orientation moves the joined edges to top and bottom.</p>
  </Component>

  <ButtonGroupContent />
</MainLayout>
