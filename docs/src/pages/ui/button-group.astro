---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import ButtonGroupContent from "@ui/concepts/button-group.mdx";
import ButtonGroupDemo, { ButtonGroupPlateDemo, ButtonGroupVerticalDemo } from "../../demos/button-group-demo";
import demoSource from "../../demos/button-group-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/button-group.css", "utf8");

const title = "Button Group";
const description = "Interactive Button Group demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Button Group</h1>
  <p>A flex container that joins buttons, inputs, and text into one visual control: inner edges are rounded and de-bordered so a row or column of separate elements reads as a single widget.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "ButtonGroupDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <ButtonGroupDemo client:load />
  </Demo>
  <InstallSection entry="button-group" />
  <ButtonGroupContent />
  <h2>Examples</h2>
  <Demo id="demo-plate" title="Text plate" code={demoCode(demoSource, "ButtonGroupPlateDemo")} note="ButtonGroupText renders the muted prefix plate; compose it with your own input copy.">
    <ButtonGroupPlateDemo client:load />
  </Demo>
  <Demo id="demo-vertical" title="Vertical orientation" code={demoCode(demoSource, "ButtonGroupVerticalDemo")} note="orientation moves the joined edges to top and bottom.">
    <ButtonGroupVerticalDemo client:load />
  </Demo>
</MainLayout>
