---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import AccordionContent from "@ui/concepts/accordion.mdx";
import Component from "../../components/Component.astro";

import { AccordionDemo, AccordionMultipleDemo, AccordionDisabledDemo } from "../../demos/accordion-demo";

const title = "Accordion";
const description = "Interactive Accordion demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Accordion</h1>
  <p>Each row is an item whose trigger toggles its content region. Animations use a measurement-free grid, so content height is never explicitly measured.</p>

  <InstallSection entry="accordion" />

  <Component heading="Playground" Demo={<AccordionDemo client:load />} code="AccordionDemo"/>
  <Component heading="Multiple" Demo={<AccordionMultipleDemo client:load />} code="AccordionMultipleDemo">
    <p>Multiple mode toggles set membership; the roving arrows move focus while clicks do the selecting.</p>
  </Component>
  <Component heading="Disabled" Demo={<AccordionDisabledDemo client:load />} code="AccordionDisabledDemo">
    <p>The disabled row ignores activation in every mode.</p>
  </Component>

  <AccordionContent />
</MainLayout>
