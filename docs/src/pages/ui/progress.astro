---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import ProgressContent from "@ui/concepts/progress.mdx";

const title = "Progress";
const description = "Interactive Progress demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const indeterminateCode = `<Progress value={() => scanning()} />`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Progress</h1>
  <p>A `role="progressbar"` track whose indicator fills from 0 to 100 through an inline transform, with an indeterminate state driven by a null value.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="progress" />
  <ProgressContent />
  <h2>Examples</h2>
  <Demo id="demo-indeterminate" title="Indeterminate" code={indeterminateCode} note="A null value drives the indeterminate sweep; 100 and above report complete." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import Progress from "../../components/ui/progress";
  import "../../components/ui/tokens.js";

  const uploaded = signal(40);
  const step = () => uploaded(uploaded() >= 100 ? 0 : uploaded() + 20);
  mount(html`<div class="flex flex-col gap-2">
    <${Progress} value=${() => uploaded()} />
    <button class="w-fit rounded-md border px-2 py-1 text-xs" on:click=${step}>Advance upload (${() => uploaded()}%)</button>
  </div>`, document.getElementById("demo")!);

  const scanning = signal(null);
  mount(html`<${Progress} value=${() => scanning()} />`, document.getElementById("demo-indeterminate")!);
</script>
