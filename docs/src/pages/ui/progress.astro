---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ProgressContent from "@ui/concepts/progress.mdx";
import Component from "../../components/Component.astro";

import { ProgressDemo, ProgressIndeterminateDemo } from "../../demos/progress-demo";

const title = "Progress";
const description = "Interactive Progress demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Progress</h1>
  <p>A role="progressbar" track whose indicator fills from 0 to 100 through an inline transform, with an indeterminate state driven by a null value.</p>

  <InstallSection entry="progress" />

  <Component heading="Playground" Demo={<ProgressDemo />} code="ProgressDemo"/>
  <Component heading="Indeterminate" Demo={<ProgressIndeterminateDemo />} code="ProgressIndeterminateDemo">
    <p>A null value drives the indeterminate sweep; 100 and above report complete.</p>
  </Component>

  <ProgressContent />
</MainLayout>
