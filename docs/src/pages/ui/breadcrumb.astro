---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import BreadcrumbContent from "@ui/concepts/breadcrumb.mdx";
import Component from "../../components/Component.astro";

import { BreadcrumbDemo, BreadcrumbCollapsedDemo } from "../../demos/breadcrumb-demo";

const title = "Breadcrumb";
const description = "Interactive Breadcrumb demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Breadcrumb</h1>
  <p>A navigation trail: an ordered list of items with separators, the current page marked for assistive tech, an ellipsis for collapsed segments, and dropdown composition for overflow.</p>

  <InstallSection entry="breadcrumb" />

  <Component heading="Playground" Demo={<BreadcrumbDemo />} code="BreadcrumbDemo">
    <p>The current page is marked for assistive tech; separators are presentation-only and hidden from the accessibility tree.</p>
  </Component>
  <Component heading="Collapsed segments" Demo={<BreadcrumbCollapsedDemo client:load />} code="BreadcrumbCollapsedDemo">
    <p>The ellipsis hosts a DropdownMenu holding the hidden levels; the trail ends on the current page.</p>
  </Component>

  <BreadcrumbContent />
</MainLayout>
