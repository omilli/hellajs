---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import SpinnerContent from "@ui/concepts/spinner.mdx";
import SpinnerDemo, { SpinnerBusyDemo } from "../../demos/spinner-demo";
import demoSource from "../../demos/spinner-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/spinner.css", "utf8");

const title = "Spinner";
const description = "Interactive Spinner demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Spinner</h1>
  <p>An operation-in-progress indicator: the loader-circle glyph inlined as a fixed svg, spinning through a css animation and announcing itself to assistive tech.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "SpinnerDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <SpinnerDemo client:load />
  </Demo>
  <InstallSection entry="spinner" />
  <SpinnerContent />
  <h2>Examples</h2>
  <Demo id="demo-busy" title="Busy action" code={demoCode(demoSource, "SpinnerBusyDemo")} note="role=status and aria-label=Loading announce the wait; the disabled button stops repeat clicks.">
    <SpinnerBusyDemo client:load />
  </Demo>
</MainLayout>
