---
import MainLayout from "../../layouts/MainLayout.astro";
import SpinnerContent from "@ui/concepts/spinner.mdx";

const title = "Spinner";
const description = "Interactive Spinner demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <SpinnerContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Spinner from "../../components/ui/spinner";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <div class="demo-row items-center">
      <${Spinner} />
      <span class="text-sm text-muted-foreground">Default size</span>
    </div>
    <div class="demo-row items-center">
      <${Spinner} class="size-6" />
      <span class="text-sm text-muted-foreground">Large</span>
    </div>
    <div class="demo-row items-center">
      <button type="button" disabled class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground opacity-50">
        <${Spinner} class="size-4" />
        Saving...
      </button>
    </div>
  </div>`, document.getElementById("demo")!);
</script>
