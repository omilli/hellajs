---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import ToggleContent from "@ui/concepts/toggle.mdx";
import ToggleDemo, { ToggleNeighborDemo } from "../../demos/toggle-demo";
import demoSource from "../../demos/toggle-demo.tsx?raw";
import { demoCode } from "../../utils/demo-code";

const title = "Toggle";
const description = "Interactive Toggle demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }}>
  <h1>Toggle</h1>
  <p>A pressed-state button: aria-pressed and data-state drive the look, with variant and size maps plus a toggleVariants resolver for neighboring markup.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "ToggleDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <ToggleDemo client:load />
  </Demo>
  <InstallSection entry="toggle" />
  <ToggleContent />
  <h2>Examples</h2>
  <Demo id="demo-neighbor" title="Neighboring markup" code={demoCode(demoSource, "ToggleNeighborDemo")} note="toggleVariants resolves the same class string the component renders, so a plain button matches it exactly.">
    <ToggleNeighborDemo client:load />
  </Demo>
</MainLayout>
