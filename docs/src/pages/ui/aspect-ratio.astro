---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import AspectRatioContent from "@ui/concepts/aspect-ratio.mdx";
import Component from "../../components/Component.astro";

import { AspectRatioDemo, AspectRatioRatiosDemo } from "../../demos/aspect-ratio-demo";

const title = "Aspect Ratio";
const description = "Interactive Aspect Ratio demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Aspect Ratio</h1>
  <p>A fixed-ratio container for media: one wrapper div whose inline aspect-ratio style locks the box shape while children stretch to fill it.</p>

  <InstallSection entry="aspect-ratio" />

  <Component heading="Playground" Demo={<AspectRatioDemo />} code="AspectRatioDemo"/>
  <Component type="row" heading="Other ratios" Demo={<AspectRatioRatiosDemo />} code="AspectRatioRatiosDemo">
    <p>Any number works; a bare AspectRatio defaults to a 1 / 1 square.</p>
  </Component>

  <AspectRatioContent />
</MainLayout>
