---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import AspectRatioContent from "@ui/concepts/aspect-ratio.mdx";

const title = "Aspect Ratio";
const description = "Interactive AspectRatio demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const ratiosCode = `<div class="flex gap-3">
  <AspectRatio ratio={1} class="w-32 bg-muted rounded-lg overflow-hidden">
    <div class="flex size-full items-center justify-center text-sm text-muted-foreground">
      1 / 1
    </div>
  </AspectRatio>
  <AspectRatio ratio={4 / 3} class="flex-1 bg-muted rounded-lg overflow-hidden">
    <div class="flex size-full items-center justify-center text-sm text-muted-foreground">
      4 / 3
    </div>
  </AspectRatio>
</div>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Aspect Ratio</h1>
  <p>A fixed-ratio container for media: one wrapper div whose inline aspect-ratio style locks the box shape while children stretch to fill it.</p>
  <div class="demo-frame" id="demo"></div>
  <InstallSection entry="aspect-ratio" />
  <AspectRatioContent />
  <h2>Examples</h2>
  <Demo id="demo-ratios" title="Other ratios" code={ratiosCode} note="Any number works; a bare AspectRatio defaults to a 1 / 1 square." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import AspectRatio from "../../components/ui/aspect-ratio";
  import "../../components/ui/tokens.js";

  mount(html`<${AspectRatio} ratio=${16 / 9} class="bg-muted rounded-lg overflow-hidden">
    <div class="flex size-full items-center justify-center text-sm text-muted-foreground">16 / 9</div>
  </${AspectRatio}>`, document.getElementById("demo")!);

  mount(html`<div class="flex gap-3">
    <${AspectRatio} ratio=${1} class="w-32 bg-muted rounded-lg overflow-hidden">
      <div class="flex size-full items-center justify-center text-sm text-muted-foreground">1 / 1</div>
    </${AspectRatio}>
    <${AspectRatio} ratio=${4 / 3} class="flex-1 bg-muted rounded-lg overflow-hidden">
      <div class="flex size-full items-center justify-center text-sm text-muted-foreground">4 / 3</div>
    </${AspectRatio}>
  </div>`, document.getElementById("demo-ratios")!);
</script>
