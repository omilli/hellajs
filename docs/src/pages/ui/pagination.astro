---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import PaginationContent from "@ui/concepts/pagination.mdx";
import PaginationDemo, { PaginationAnchorDemo } from "../../demos/pagination-demo";
import demoSource from "../../demos/pagination-demo.tsx?raw";
import { demoCode } from "../../utils/demo-code";

const title = "Pagination";
const description = "Interactive Pagination demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }}>
  <h1>Pagination</h1>
  <p>A navigation landmark for paged content: a centered nav wrapping a list of links, with previous/next controls, an ellipsis overflow marker, and an active-page state rendered through the button visual vocabulary.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "PaginationDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <PaginationDemo client:load />
  </Demo>
  <InstallSection entry="pagination" />
  <PaginationContent />
  <h2>Examples</h2>
  <Demo id="demo-anchor" title="Anchor paging" code={demoCode(demoSource, "PaginationAnchorDemo")} note="Plain hrefs keep the landmark a real navigation element; isActive renders aria-current and the outline treatment.">
    <PaginationAnchorDemo client:load />
  </Demo>
</MainLayout>
