---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import CardContent from "@ui/concepts/card.mdx";

const title = "Card";
const description = "Interactive Card demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const heroCode = `import Card, { CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from './components/card';
import Button from './components/button';

const NotificationsCard = () => (
  <Card class="w-80">
    <CardHeader>
      <CardTitle>Notifications</CardTitle>
      <CardDescription>You have three unread messages.</CardDescription>
      <CardAction>
        <Button size="sm" variant="outline">Mark all read</Button>
      </CardAction>
    </CardHeader>
    <CardContent>
      <p>Review your notification preferences and inbox rules.</p>
    </CardContent>
    <CardFooter>
      <Button>Open settings</Button>
    </CardFooter>
  </Card>
);`;

const minimalCode = `import Card, { CardContent, CardDescription, CardHeader, CardTitle } from './components/card';

const StatCard = () => (
  <Card class="max-w-sm">
    <CardHeader>
      <CardTitle>Deploys</CardTitle>
      <CardDescription>128 this week.</CardDescription>
    </CardHeader>
    <CardContent>
      <p>All regions green.</p>
    </CardContent>
  </Card>
);`;
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="card" />
  <CardContent />
  <h2>Examples</h2>
  <Demo id="demo-minimal" title="Minimal arrangement" code={minimalCode} note="Parts are optional: a card of header and content alone is a complete card." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Button from "../../components/ui/button";
  import Card, { CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "../../components/ui/card";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <${Card} class="demo-card">
      <${CardHeader}>
        <${CardTitle}>Notifications</${CardTitle}>
        <${CardDescription}>You have three unread messages waiting in your inbox.</${CardDescription}>
        <${CardAction}><${Button} variant="outline" size="sm">Mark all read</${Button}></${CardAction}>
      </${CardHeader}>
      <${CardContent}><p>Review your notification preferences and inbox rules at any time from settings.</p></${CardContent}>
      <${CardFooter}><${Button}>Open settings</${Button}></${CardFooter}>
    </${Card}>
  </div>`, document.getElementById("demo")!);

  mount(html`<${Card} class="demo-card">
    <${CardHeader}>
      <${CardTitle}>Deploys</${CardTitle}>
      <${CardDescription}>128 this week.</${CardDescription}>
    </${CardHeader}>
    <${CardContent}><p>All regions green.</p></${CardContent}>
  </${Card}>`, document.getElementById("demo-minimal")!);
</script>
