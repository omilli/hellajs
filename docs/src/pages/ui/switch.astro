---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import SwitchContent from "@ui/concepts/switch.mdx";
import Component from "../../components/Component.astro";

import { SwitchDemo, SwitchDisabledDemo } from "../../demos/switch-demo";

const title = "Switch";
const description = "Interactive Switch demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Switch</h1>
  <p>An on/off control: a switch-role button whose thumb slides through pure CSS, rendering aria-checked and data-state on root and thumb.</p>

  <InstallSection entry="switch" />

  <Component heading="Playground" Demo={<SwitchDemo client:load />} code="SwitchDemo">
    <p>The thumb slides through pure CSS: the style layer reads the root's data-state and translates the knob.</p>
  </Component>
  <Component heading="Disabled" Demo={<SwitchDisabledDemo />} code="SwitchDisabledDemo">
    <p>The disabled attribute blocks pointer and keyboard activation; Space falls through.</p>
  </Component>

  <SwitchContent />
</MainLayout>
