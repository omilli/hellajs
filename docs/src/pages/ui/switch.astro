---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import SwitchContent from "@ui/concepts/switch.mdx";
import SwitchDemo, { SwitchDisabledDemo } from "../../demos/switch-demo";
import demoSource from "../../demos/switch-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/switch.css", "utf8");

const title = "Switch";
const description = "Interactive Switch demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Switch</h1>
  <p>An on/off control: a switch-role button whose thumb slides through pure CSS, rendering aria-checked and data-state on root and thumb.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "SwitchDemo", { withImports: true })} note="The thumb slides through pure CSS: the style layer reads the root's data-state and translates the knob.">
    <SwitchDemo client:load />
  </Demo>
  <InstallSection entry="switch" />
  <SwitchContent />
  <h2>Examples</h2>
  <Demo id="demo-disabled" title="Disabled" code={demoCode(demoSource, "SwitchDisabledDemo")} note="The disabled attribute blocks pointer and keyboard activation; Space falls through.">
    <SwitchDisabledDemo client:load />
  </Demo>
</MainLayout>
