---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import InputContent from "@ui/concepts/input.mdx";
import Component from "../../components/Component.astro";

import { InputDemo, InputInvalidDemo } from "../../demos/input-demo";

const title = "Input";
const description = "Interactive Input demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Input</h1>
  <p>A single-line form field: one base look, a focus ring, and an invalid state, reading and writing its value reactively.</p>

  <InstallSection entry="input" />

  <Component heading="Playground" Demo={<InputDemo />} code="InputDemo"/>
  <Component heading="Invalid state" Demo={<InputInvalidDemo />} code="InputInvalidDemo">
    <p>ariaInvalid draws the destructive border and ring for failed validation.</p>
  </Component>

  <InputContent />
</MainLayout>
