---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import AlertDialogContent from "@ui/concepts/alert-dialog.mdx";
import AlertDialogDemo, { AlertDialogManualDemo } from "../../demos/alert-dialog-demo";
import demoSource from "../../demos/alert-dialog-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/alert-dialog.css", "utf8");

const title = "Alert Dialog";
const description = "Interactive AlertDialog demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Alert Dialog</h1>
  <p>A modal confirmation: an overlay plus centered panel with a wired title and description and an Action/Cancel button pair, closable only through escape and the panel's own buttons.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "AlertDialogDemo", { withImports: true })} note="Opens a portal-mounted alert dialog with wired title and description, an Action/Cancel footer, and no outside-click dismissal: escape or the buttons are the only ways out.">
    <AlertDialogDemo client:load />
  </Demo>
  <InstallSection entry="alert-dialog" />
  <AlertDialogContent />
  <h2>Examples</h2>
  <Demo id="demo-manual" title="Manual parts" code={demoCode(demoSource, "AlertDialogManualDemo")} note="The same panel composed from the exported parts: overlay and content portaled by hand, both fed the state accessor; labelledBy and describedBy point at the title and description ids you assign.">
    <AlertDialogManualDemo client:load />
  </Demo>
</MainLayout>
