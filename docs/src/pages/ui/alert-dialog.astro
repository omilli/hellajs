---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import AlertDialogContent from "@ui/concepts/alert-dialog.mdx";
import Component from "../../components/Component.astro";

import { AlertDialogDemo } from "../../demos/alert-dialog-demo";

const title = "Alert Dialog";
const description = "Interactive Alert Dialog demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Alert Dialog</h1>
  <p>A modal confirmation: an overlay plus centered panel with a wired title and description and an Action/Cancel button pair, closable only through escape and the panel's own buttons.</p>

  <InstallSection entry="alert-dialog" />

  <Component heading="Playground" Demo={<AlertDialogDemo client:load />} code="AlertDialogDemo">
    <p>Opens a portal-mounted alert dialog with wired title and description, an Action/Cancel footer, and no outside-click dismissal: escape or the buttons are the only ways out.</p>
  </Component>

  <AlertDialogContent />
</MainLayout>
