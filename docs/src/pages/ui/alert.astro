---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import AlertContent from "@ui/concepts/alert.mdx";
import Component from "../../components/Component.astro";

import { AlertDemo, AlertDestructiveDemo } from "../../demos/alert-demo";

const title = "Alert";
const description = "Interactive Alert demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Alert</h1>
  <p>A callout with a default and destructive variant, named title and description parts, and a grid that reserves an icon column whenever the first child is an svg.</p>

  <InstallSection entry="alert" />

  <Component heading="Playground" Demo={<AlertDemo />} code="AlertDemo"/>
  <Component heading="Destructive" Demo={<AlertDestructiveDemo />} code="AlertDestructiveDemo">
    <p>The destructive token colors the root, the title, and the description.</p>
  </Component>

  <AlertContent />
</MainLayout>
