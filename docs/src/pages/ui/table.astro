---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import TableContent from "@ui/concepts/table.mdx";

const title = "Table";
const description = "Interactive Table demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const heroCode = `import Table, { TableBody, TableCaption, TableCell, TableFooter, TableHead, TableHeader, TableRow } from './components/table';

const invoices = [
  { invoice: 'INV001', status: 'Paid', method: 'Credit Card', amount: '$250.00' },
  { invoice: 'INV002', status: 'Pending', method: 'PayPal', amount: '$125.00' },
  { invoice: 'INV003', status: 'Paid', method: 'Bank Transfer', amount: '$310.00' },
];

const Invoices = () => (
  <Table>
    <TableCaption>A list of your recent invoices.</TableCaption>
    <TableHeader>
      <TableRow>
        <TableHead>Invoice</TableHead>
        <TableHead>Status</TableHead>
        <TableHead>Method</TableHead>
        <TableHead class="text-right">Amount</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      {invoices.map((inv) => (
        <TableRow key={inv.invoice}>
          <TableCell>{inv.invoice}</TableCell>
          <TableCell>{inv.status}</TableCell>
          <TableCell>{inv.method}</TableCell>
          <TableCell class="text-right">{inv.amount}</TableCell>
        </TableRow>
      ))}
    </TableBody>
    <TableFooter>
      <TableRow>
        <TableHead colSpan={3}>Total</TableHead>
        <TableCell class="text-right">$685.00</TableCell>
      </TableRow>
    </TableFooter>
  </Table>
);`;

const wideCode = `import Table, { TableBody, TableCell, TableHead, TableHeader, TableRow } from './components/table';

const columns = ['Invoice', 'Customer', 'Status', 'Method', 'Issued', 'Due', 'Terms', 'Amount'];

const rows = [
  ['INV001', 'Acme Corp', 'Paid', 'Credit Card', 'Mar 01', 'Mar 31', 'Net 30', '$250.00'],
  ['INV002', 'Globex', 'Pending', 'PayPal', 'Mar 04', 'Apr 03', 'Net 30', '$125.00'],
  ['INV003', 'Initech', 'Paid', 'Bank Transfer', 'Mar 09', 'Apr 08', 'Net 30', '$310.00'],
];

const Ledger = () => (
  <Table>
    <TableHeader>
      <TableRow>
        {columns.map((col) => <TableHead>{col}</TableHead>)}
      </TableRow>
    </TableHeader>
    <TableBody>
      {rows.map((cells) => (
        <TableRow>
          {cells.map((cell, index) => (
            <TableCell class={index === 7 ? 'text-right' : undefined}>{cell}</TableCell>
          ))}
        </TableRow>
      ))}
    </TableBody>
  </Table>
);`;
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="table" />
  <TableContent />
  <h2>Examples</h2>
  <Demo id="demo-wide" title="Wide tables scroll" code={wideCode} note="Table renders the overflow container, so more columns than the frame fits scroll horizontally instead of breaking the page." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Table, { TableBody, TableCaption, TableCell, TableFooter, TableHead, TableHeader, TableRow } from "../../components/ui/table";
  import "../../components/ui/tokens.js";

  const invoices = [
    { invoice: "INV001", status: "Paid", method: "Credit Card", amount: "$250.00" },
    { invoice: "INV002", status: "Pending", method: "PayPal", amount: "$125.00" },
    { invoice: "INV003", status: "Paid", method: "Bank Transfer", amount: "$310.00" },
  ];
  const row = (invoice) => html`<${TableRow}>
    <${TableCell}>${invoice.invoice}</${TableCell}>
    <${TableCell}>${invoice.status}</${TableCell}>
    <${TableCell}>${invoice.method}</${TableCell}>
    <${TableCell} class="text-right">${invoice.amount}</${TableCell}>
  </${TableRow}>`;
  mount(html`<${Table}>
    <${TableCaption}>A list of your recent invoices.</${TableCaption}>
    <${TableHeader}><${TableRow}>
      <${TableHead}>Invoice</${TableHead}>
      <${TableHead}>Status</${TableHead}>
      <${TableHead}>Method</${TableHead}>
      <${TableHead} class="text-right">Amount</${TableHead}>
    </${TableRow}></${TableHeader}>
    <${TableBody}>${() => invoices.map(row)}</${TableBody}>
    <${TableFooter}><${TableRow}>
      <${TableHead} colSpan=${3}>Total</${TableHead}>
      <${TableCell} class="text-right">$685.00</${TableCell}>
    </${TableRow}></${TableFooter}>
  </${Table}>`, document.getElementById("demo")!);

  const columns = ["Invoice", "Customer", "Status", "Method", "Issued", "Due", "Terms", "Amount"];
  const ledger = [
    ["INV001", "Acme Corp", "Paid", "Credit Card", "Mar 01", "Mar 31", "Net 30", "$250.00"],
    ["INV002", "Globex", "Pending", "PayPal", "Mar 04", "Apr 03", "Net 30", "$125.00"],
    ["INV003", "Initech", "Paid", "Bank Transfer", "Mar 09", "Apr 08", "Net 30", "$310.00"],
  ];
  mount(html`<${Table}>
    <${TableHeader}><${TableRow}>
      ${columns.map((col) => html`<${TableHead}>${col}</${TableHead}>`)}
    </${TableRow}></${TableHeader}>
    <${TableBody}>
      ${ledger.map((cells) => html`<${TableRow}>
        ${cells.map((cell, index) => html`<${TableCell} class=${index === 7 ? "text-right" : null}>${cell}</${TableCell}>`)}
      </${TableRow}>`)}
    </${TableBody}>
  </${Table}>`, document.getElementById("demo-wide")!);
</script>
