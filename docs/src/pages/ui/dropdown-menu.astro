---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import DropdownMenuContent from "@ui/concepts/dropdown-menu.mdx";
import Component from "../../components/Component.astro";

import { DropdownMenuDemo, DropdownMenuSubmenuDemo } from "../../demos/dropdown-menu-demo";

const title = "Dropdown Menu";
const description = "Interactive Dropdown Menu demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Dropdown Menu</h1>
  <p>A button-triggered menu: the trigger opens a portaled, anchored surface of items; checkbox and radio items select state; submenus open on hover or ArrowRight; Escape pops one layer at a time and item selection closes the whole menu.</p>

  <InstallSection entry="dropdown-menu" />

  <Component heading="Playground" Demo={<DropdownMenuDemo client:load />} code="DropdownMenuDemo">
    <p>The checkbox toggles through its accessor and the radio group keeps selection external; activating any item closes the whole menu.</p>
  </Component>
  <Component heading="Submenu nesting" Demo={<DropdownMenuSubmenuDemo client:load />} code="DropdownMenuSubmenuDemo">
    <p>Hover or ArrowRight enters the sub; Escape pops one layer at a time and an outside press closes the sub before the parent.</p>
  </Component>

  <DropdownMenuContent />
</MainLayout>
