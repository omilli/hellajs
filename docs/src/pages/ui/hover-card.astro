---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import HoverCardContent from "@ui/concepts/hover-card.mdx";
import Component from "../../components/Component.astro";

import { HoverCardDemo } from "../../demos/hover-card-demo";

const title = "Hover Card";
const description = "Interactive Hover Card demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Hover Card</h1>
  <p>A rich preview card: hovering the trigger opens an anchored panel, moving the pointer into the panel keeps it open, and focus follows the same open and close path a pointer takes.</p>

  <InstallSection entry="hover-card" />

  <Component heading="Playground" Demo={<HoverCardDemo client:load />} code="HoverCardDemo">
    <p>Hovering opens the anchored preview after a short delay; moving the pointer into the card keeps it open, and focus opens it from the keyboard.</p>
  </Component>

  <HoverCardContent />
</MainLayout>
