---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import FieldContent from "@ui/concepts/field.mdx";
import Component from "../../components/Component.astro";

import { FieldDemo, FieldStateDemo, FieldResponsiveDemo } from "../../demos/field-demo";

const title = "Field";
const description = "Interactive Field demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Field</h1>
  <p>A form-field composition kit: ten parts covering the set, legend, group, field row, content stack, label, title, description, separator, and error, wired so disabled and invalid state on the field propagates to its label and title.</p>

  <InstallSection entry="field" />

  <Component heading="Playground" Demo={<FieldDemo />} code="FieldDemo"/>
  <Component heading="Disabled and invalid propagation" Demo={<FieldStateDemo />} code="FieldStateDemo">
    <p>Disabled fades the label and title, invalid turns the field text destructive - neither touches the children's props.</p>
  </Component>
  <Component heading="Responsive orientation" Demo={<FieldResponsiveDemo />} code="FieldResponsiveDemo">
    <p>Inside a FieldGroup the responsive orientation goes horizontal once the group is at least 28rem wide.</p>
  </Component>

  <FieldContent />
</MainLayout>
