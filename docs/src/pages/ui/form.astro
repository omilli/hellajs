---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import FormContent from "@ui/concepts/form.mdx";
import FormDemo, { FormBlurDemo, FormResetDemo } from "../../demos/form-demo";
import demoSource from "../../demos/form-demo.tsx?raw";
import { demoCode } from "../../utils/demo-code";

const title = "Form";
const description = "Signals-native form demo running the site's built registry source via an Astro island, with the controller, validators, and explicit-state parts.";

---

<MainLayout frontmatter={{ title, description }}>
  <h1>Form</h1>
  <p>A signals-native form controller: createForm owns values, errors, touched, and dirty as plain signals, and five parts compose each field row around it.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "FormDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <FormDemo client:load />
  </Demo>
  <InstallSection entry="form" />
  <FormContent />
  <h2>Examples</h2>
  <Demo id="demo-blur" title="Blur validation" code={demoCode(demoSource, "FormBlurDemo")} note="A bubbling focusout handler calls blur(key): leaving the field validates it without a submit.">
    <FormBlurDemo client:load />
  </Demo>
  <Demo id="demo-reset" title="Reset" code={demoCode(demoSource, "FormResetDemo")} note="reset() restores every field to its initial value and clears errors, touched, and dirty. Edit, submit into an error, then reset.">
    <FormResetDemo client:load />
  </Demo>
</MainLayout>
