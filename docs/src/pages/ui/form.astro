---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import FormContent from "@ui/concepts/form.mdx";
import Component from "../../components/Component.astro";

import { FormDemo, FormBlurDemo, FormResetDemo } from "../../demos/form-demo";

const title = "Form";
const description = "Interactive Form demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Form</h1>
  <p>A signals-native form controller: createForm owns values, errors, touched, and dirty as plain signals, and five parts compose each field row around it.</p>

  <InstallSection entry="form" />

  <Component heading="Playground" Demo={<FormDemo client:load />} code="FormDemo"/>
  <Component heading="Blur validation" Demo={<FormBlurDemo client:load />} code="FormBlurDemo">
    <p>A bubbling focusout handler calls blur(key): leaving the field validates it without a submit.</p>
  </Component>
  <Component heading="Reset" Demo={<FormResetDemo client:load />} code="FormResetDemo">
    <p>Reset restores every field to its initial value and clears errors, touched, and dirty. Edit, submit into an error, then reset.</p>
  </Component>

  <FormContent />
</MainLayout>
