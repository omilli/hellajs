---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import NativeSelectContent from "@ui/concepts/native-select.mdx";
import Component from "../../components/Component.astro";

import { NativeSelectDemo, NativeSelectCompactDemo } from "../../demos/native-select-demo";

const title = "Native Select";
const description = "Interactive Native Select demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Native Select</h1>
  <p>A styled native select: the real element (full keyboard and mobile behavior) inside a relative wrapper with an inlined chevron-down icon, plus thin passthroughs for option and optgroup.</p>

  <InstallSection entry="native-select" />

  <Component type="row" heading="Playground" Demo={<NativeSelectDemo />} code="NativeSelectDemo"/>
  <Component type="row" heading="Compact size" Demo={<NativeSelectCompactDemo />} code="NativeSelectCompactDemo">
    <p>size="sm" toggles the data-size treatment on the select.</p>
  </Component>

  <NativeSelectContent />
</MainLayout>
