---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import ItemContent from "@ui/concepts/item.mdx";

const title = "Item";
const description = "Interactive Item demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const selectionCode = `<div on:click={(e) => {
  const row = e.target.closest('[data-slot="item"]');
  if (row) active([...row.parentElement.children].indexOf(row));
}}>
  <ItemGroup>
    {['Alpha', 'Beta'].map((label, i) => (
      <Item key={label} selected={() => active() === i}>
        <ItemContent><ItemTitle>{label}</ItemTitle></ItemContent>
      </Item>
    ))}
  </ItemGroup>
</div>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Item</h1>
  <p>A flexible list-row composition kit: ten parts covering the group, separator, row, media slot, content stack, title, description, actions, header, and footer, built for settings lists, result rows, and media objects.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="item" />
  <ItemContent />
  <h2>Examples</h2>
  <Demo id="demo-selection" title="Reactive selection" code={selectionCode} note="Rows carry no click wiring; a delegated on:click on the wrapper flips the signal and selected drives data-selected and aria-selected." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "../../components/ui/item";
  import Button from "../../components/ui/button";
  import "../../components/ui/tokens.js";

  const row = (title, copy) => html`<${Item}>
    <${ItemMedia} variant="icon">${title[0]}</${ItemMedia}>
    <${ItemContent}>
      <${ItemTitle}>${title}</${ItemTitle}>
      <${ItemDescription}>${copy}</${ItemDescription}>
    </${ItemContent}>
    <${ItemActions}><${Button} size="sm" variant="outline">Run</${Button}></${ItemActions}>
  </${Item}>`;
  mount(html`<${ItemGroup}>
    ${row("Archive", "Move the report to long-term storage.")}
    <${ItemSeparator} />
    ${row("Export", "Download a CSV of every entry.")}
    <${ItemSeparator} />
    ${row("Share", "Invite two teammates to collaborate.")}
  </${ItemGroup}>`, document.getElementById("demo")!);

  const active = signal(0);
  const option = (label, i) => html`<${Item} selected=${() => active() === i}>
    <${ItemContent}><${ItemTitle}>${label}</${ItemTitle}></${ItemContent}>
  </${Item}>`;
  mount(html`<div on:click="${(e) => {
    const row = e.target.closest('[data-slot="item"]');
    if (row) active([...row.parentElement.children].indexOf(row));
  }}">
    <${ItemGroup}>
      ${["Alpha", "Beta", "Gamma"].map((label, i) => option(label, i))}
    </${ItemGroup}>
    <p class="demo-note">Click a row - selection drives data-selected and aria-selected.</p>
  </div>`, document.getElementById("demo-selection")!);
</script>
