---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import MessageContent from "@ui/concepts/message.mdx";

const title = "Message";
const description = "Interactive Message demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const heroCode = `import { Bubble } from './components/bubble';
import { Message, MessageAvatar, MessageContent, MessageFooter, MessageHeader, MessageGroup } from './components/message';

const Thread = () => (
  <MessageGroup>
    <Message>
      <MessageAvatar><span>Ad</span></MessageAvatar>
      <MessageContent>
        <MessageHeader>Ada</MessageHeader>
        <Bubble variant="outline">How does the scroller pin to the bottom?</Bubble>
        <MessageFooter>2 minutes ago</MessageFooter>
      </MessageContent>
    </Message>
    <Message>
      <MessageAvatar><span>Gr</span></MessageAvatar>
      <MessageContent>
        <MessageHeader>Grace</MessageHeader>
        <Bubble variant="outline">A scroll listener watches the distance to the bottom.</Bubble>
        <MessageFooter>A minute ago</MessageFooter>
      </MessageContent>
    </Message>
  </MessageGroup>
);`;

const endCode = `import { Bubble } from './components/bubble';
import { Message, MessageAvatar, MessageContent, MessageFooter, MessageHeader } from './components/message';

const Sent = () => (
  <Message align="end">
    <MessageAvatar><span>You</span></MessageAvatar>
    <MessageContent>
      <MessageHeader>You</MessageHeader>
      <Bubble>On my way.</Bubble>
      <MessageFooter>Just now</MessageFooter>
    </MessageContent>
  </Message>
);`;
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="message" />
  <MessageContent />
  <h2>Examples</h2>
  <Demo id="demo-end" title="Sent alignment" code={endCode} note="One prop mirrors the row for sent messages; no extra classes on the parts." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { Message, MessageAvatar, MessageContent, MessageFooter, MessageGroup, MessageHeader } from "../../components/ui/message";
  import { Bubble } from "../../components/ui/bubble";
  import "../../components/ui/tokens.js";

  const row = (name, initial, time, text) => html`<${Message}>
    <${MessageAvatar}><span style="font-size:0.625rem">${initial}</span></${MessageAvatar}>
    <${MessageContent}>
      <${MessageHeader}>${name}</${MessageHeader}>
      <${Bubble} variant="outline">${text}</${Bubble}>
      <${MessageFooter}>${time}</${MessageFooter}>
    </${MessageContent}>
  </${Message}>`;

  mount(html`<div class="demo-stack">
    <${MessageGroup}>
      ${row("Ada", "Ad", "2 minutes ago", "How does the scroller pin to the bottom?")}
      ${row("Grace", "Gr", "A minute ago", "A scroll listener watches the distance to the bottom.")}
    </${MessageGroup}>
  </div>`, document.getElementById("demo")!);

  mount(html`<${Message} align="end">
    <${MessageAvatar}><span style="font-size:0.625rem">You</span></${MessageAvatar}>
    <${MessageContent}>
      <${MessageHeader}>You</${MessageHeader}>
      <${Bubble}>On my way.</${Bubble}>
      <${MessageFooter}>Just now</${MessageFooter}>
    </${MessageContent}>
  </${Message}>`, document.getElementById("demo-end")!);
</script>
