---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import RadioGroupContent from "@ui/concepts/radio-group.mdx";
import Component from "../../components/Component.astro";

import { RadioGroupDemo, RadioGroupHorizontalDemo } from "../../demos/radio-group-demo";

const title = "Radio Group";
const description = "Interactive Radio Group demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Radio Group</h1>
  <p>A single-selection control: a radiogroup root rendering one labeled row per entry, with arrow-key focus movement shared through roving tabindex.</p>

  <InstallSection entry="radio-group" />

  <Component heading="Playground" Demo={<RadioGroupDemo client:load />} code="RadioGroupDemo"/>
  <Component heading="Horizontal orientation" Demo={<RadioGroupHorizontalDemo client:load />} code="RadioGroupHorizontalDemo">
    <p>aria-orientation moves to the root and the arrow keys scope to Left and Right.</p>
  </Component>

  <RadioGroupContent />
</MainLayout>
