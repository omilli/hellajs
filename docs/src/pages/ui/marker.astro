---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import MarkerContent from "@ui/concepts/marker.mdx";
import Component from "../../components/Component.astro";

import { MarkerDemo, MarkerSeparatorDemo, MarkerBorderDemo } from "../../demos/marker-demo";

const title = "Marker";
const description = "Interactive Marker demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Marker</h1>
  <p>A labeled divider row: a full-width strip that presents a short label, with optional rule pseudo-elements or a bottom border, built for timeline captions, empty-state annotations, and section leads.</p>

  <InstallSection entry="marker" />

  <Component heading="Playground" Demo={<MarkerDemo />} code="MarkerDemo"/>
  <Component heading="Rule variant" Demo={<MarkerSeparatorDemo />} code="MarkerSeparatorDemo">
    <p>The separator variant adds flex-filling rules before and after the content.</p>
  </Component>
  <Component heading="Border variant" Demo={<MarkerBorderDemo />} code="MarkerBorderDemo">
    <p>The border variant adds a bottom border - built for end-of-list captions.</p>
  </Component>

  <MarkerContent />
</MainLayout>
