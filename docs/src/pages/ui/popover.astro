---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import PopoverTitle from "@ui/concepts/popover.mdx";

const title = "Popover";
const description = "Interactive Popover demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const manualCode = `<>
  <button
    type="button"
    hook:afterMount={(node) => { button = node; }}
    on:click={() => open(!open())}
  >
    Open
  </button>
  {() => open() && (
    <Portal to="body">
      <PopoverContent state={state} anchor={() => button} onDismiss={() => open(false)}>
        <PopoverHeader>
          <PopoverTitle>Dimensions</PopoverTitle>
          <PopoverDescription>Set the width and height.</PopoverDescription>
        </PopoverHeader>
      </PopoverContent>
    </Portal>
  )}
</>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Popover</h1>
  <p>A click-toggled panel anchored to its trigger: Escape and an outside press dismiss it, and stacked popovers dismiss one layer at a time, top first.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="popover" />
  <PopoverTitle />
  <h2>Examples</h2>
  <Demo id="demo-manual" title="Manual parts" code={manualCode} note="The content part takes the state accessor, the anchor, and the onDismiss callback that layerDismissal fires into." />
</MainLayout>

<script>
  import { html, mount, Portal } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import Button from "../../components/ui/button";
  import Popover, { PopoverContent, PopoverDescription, PopoverHeader, PopoverTitle } from "../../components/ui/popover";
  import "../../components/ui/tokens.js";

  const panel = (name: string) => html`
    <${PopoverHeader}>
      <${PopoverTitle}>${name}</${PopoverTitle}>
      <${PopoverDescription}>Escape or an outside press closes the top layer only.</${PopoverDescription}>
    </${PopoverHeader}>
    <p>Width 18rem, positioned against the trigger, flipping on viewport collision.</p>
  `;

  mount(html`<div class="demo-stack">
    <div class="demo-row">
      <${Popover} content=${panel("Width")}><${Button}>Width</${Button}></${Popover}>
      <${Popover} content=${panel("Height")}><${Button} variant="outline">Height</${Button}></${Popover}>
    </div>
    <p class="demo-note">Clicking toggles a non-modal panel; open both and press Escape to see layered dismissal close one at a time.</p>
  </div>`, document.getElementById("demo")!);

  const manualOpen = signal(false);
  const manualState = (): "open" | "closed" => (manualOpen() ? "open" : "closed");
  let manualButton: Element | undefined;

  mount(html`<div class="demo-stack">
    <${Button}
      hook:afterMount=${(node: Element) => { manualButton = node; }}
      onclick=${() => manualOpen(!manualOpen())}
    >Open</${Button}>
    ${() => manualOpen() && Portal({
      to: "body",
      children: [PopoverContent({
        state: manualState,
        anchor: () => manualButton,
        onDismiss: () => manualOpen(false),
        children: html`
          <${PopoverHeader}>
            <${PopoverTitle}>Dimensions</${PopoverTitle}>
            <${PopoverDescription}>Set the width and height.</${PopoverDescription}>
          </${PopoverHeader}>
        `,
      })],
    })}
  </div>`, document.getElementById("demo-manual")!);
</script>
