---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import PopoverContent from "@ui/concepts/popover.mdx";
import Component from "../../components/Component.astro";

import { PopoverDemo, PopoverManualDemo } from "../../demos/popover-demo";

const title = "Popover";
const description = "Interactive Popover demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Popover</h1>
  <p>A click-toggled panel anchored to its trigger: Escape and an outside press dismiss it, and stacked popovers dismiss one layer at a time, top first.</p>

  <InstallSection entry="popover" />

  <Component heading="Playground" Demo={<PopoverDemo client:load />} code="PopoverDemo">
    <p>Clicking toggles a non-modal panel; open both and press Escape to see layered dismissal close one at a time.</p>
  </Component>
  <Component heading="Manual parts" Demo={<PopoverManualDemo client:load />} code="PopoverManualDemo">
    <p>The content part takes the state accessor, the anchor, and the onDismiss callback that layerDismissal fires into.</p>
  </Component>

  <PopoverContent />
</MainLayout>
