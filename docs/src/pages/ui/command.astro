---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import CommandContent from "@ui/concepts/command.mdx";
import Component from "../../components/Component.astro";

import { CommandDemo, CommandPaletteDemo } from "../../demos/command-demo";

const title = "Command";
const description = "Interactive Command demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Command</h1>
  <p>A command palette: the items-driven root owns the query signal and a scoring filter, ranks matches across labels, values, and keywords, and drives the active item over a flat ranked list.</p>

  <InstallSection entry="command" />

  <Component heading="Playground" Demo={<CommandDemo client:load />} code="CommandDemo">
    <p>Typing ranks matches across labels, values, and keywords: earlier starts, word-boundary starts, and keyword hits score higher; arrows move the accent row and Enter reports the active value.</p>
  </Component>
  <Component heading="Palette dialog" Demo={<CommandPaletteDemo client:load />} code="CommandPaletteDemo">
    <p>CommandDialog wraps the palette in the dialog surface: overlay, portal, focus trap with restore, and escape plus outside-press dismissal.</p>
  </Component>

  <CommandContent />
</MainLayout>
