---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import CommandTitle from "@ui/concepts/command.mdx";
import CommandDemo, { CommandPaletteDemo } from "../../demos/command-demo";
import demoSource from "../../demos/command-demo.tsx?raw";
import { demoCode } from "../../utils/demo-code";

const title = "Command";
const description = "Interactive Command demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }}>
  <h1>Command</h1>
  <p>A command palette: the items-driven root owns the query signal and a scoring filter, ranks matches across labels, values, and keywords, and drives the active item over a flat ranked list.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "CommandDemo", { withImports: true })} note="Typing ranks matches across labels, values, and keywords: earlier starts, word-boundary starts, and keyword hits score higher; arrows move the accent row and Enter reports the active value.">
    <CommandDemo client:load />
  </Demo>
  <InstallSection entry="command" />
  <CommandTitle />
  <h2>Examples</h2>
  <Demo id="demo-palette" title="Palette dialog" code={demoCode(demoSource, "CommandPaletteDemo")} note="CommandDialog wraps the palette in the dialog surface: overlay, portal, focus trap with restore, and escape plus outside-press dismissal.">
    <CommandPaletteDemo client:load />
  </Demo>
</MainLayout>

