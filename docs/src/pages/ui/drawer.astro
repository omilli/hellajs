---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import DrawerContent from "@ui/concepts/drawer.mdx";
import Component from "../../components/Component.astro";

import { DrawerDemo } from "../../demos/drawer-demo";

const title = "Drawer";
const description = "Interactive Drawer demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Drawer</h1>
  <p>A drag-dismissable panel mounting on any screen edge: the panel follows the pointer while dragged, the overlay fades with the distance, and release past a distance or velocity threshold dismisses it.</p>

  <InstallSection entry="drawer" />

  <Component heading="Playground" Demo={<DrawerDemo client:load />} code="DrawerDemo">
    <p>Slides up from the bottom edge with a grip handle. Drag the panel down: it follows the pointer, the overlay fades with the distance, and release past 25% of the panel height (or a 500px/s flick) dismisses.</p>
  </Component>

  <DrawerContent />
</MainLayout>
