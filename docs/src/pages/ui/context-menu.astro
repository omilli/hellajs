---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ContextMenuContent from "@ui/concepts/context-menu.mdx";
import Component from "../../components/Component.astro";

import { ContextMenuDemo, ContextMenuSubsetDemo } from "../../demos/context-menu-demo";

const title = "Context Menu";
const description = "Interactive Context Menu demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Context Menu</h1>
  <p>A right-click menu: long-pressing (right-clicking) a trigger zone opens a portaled surface of items anchored at the pointer coordinates; checkbox, radio, and submenu composition match the dropdown menu, and item selection closes the whole menu.</p>

  <InstallSection entry="context-menu" />

  <Component heading="Playground" Demo={<ContextMenuDemo client:load />} code="ContextMenuDemo">
    <p>The menu opens at the pointer coordinates; Escape pops one layer, an outside press dismisses it.</p>
  </Component>
  <Component heading="Selection and submenu" Demo={<ContextMenuSubsetDemo client:load />} code="ContextMenuSubsetDemo">
    <p>One surface over a destructive action, a checkbox toggle, and a submenu; activating any item closes the whole menu.</p>
  </Component>

  <ContextMenuContent />
</MainLayout>
