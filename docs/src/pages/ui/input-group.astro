---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import InputGroupContent from "@ui/concepts/input-group.mdx";
import Component from "../../components/Component.astro";

import { InputGroupDemo, InputGroupRingsDemo, InputGroupColumnDemo } from "../../demos/input-group-demo";

const title = "Input Group";
const description = "Interactive Input Group demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Input Group</h1>
  <p>A wrapper that joins an input or textarea with buttons, text, and dropdowns under one border: the group owns the focus and invalid rings, while the control itself strips its own ring.</p>

  <InstallSection entry="input-group" />

  <Component heading="Playground" Demo={<InputGroupDemo />} code="InputGroupDemo"/>
  <Component heading="Focus and invalid rings" Demo={<InputGroupRingsDemo />} code="InputGroupRingsDemo">
    <p>The group owns both rings: focusing the control lights the composite up, and aria-invalid turns the border destructive.</p>
  </Component>
  <Component heading="Column composite" Demo={<InputGroupColumnDemo />} code="InputGroupColumnDemo">
    <p>Block alignments stack the group into a column around the control.</p>
  </Component>

  <InputGroupContent />
</MainLayout>
