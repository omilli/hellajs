---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import AvatarContent from "@ui/concepts/avatar.mdx";
import Component from "../../components/Component.astro";

import { AvatarDemo, AvatarGroupDemo } from "../../demos/avatar-demo";

const title = "Avatar";
const description = "Interactive Avatar demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Avatar</h1>
  <p>A user portrait with a graceful fallback: a rounded relative wrapper stacking an image and a fallback initial, plus a status badge, an overlapping group, and a group count.</p>

  <InstallSection entry="avatar" />

  <Component heading="Playground" Demo={<AvatarDemo client:load />} code="AvatarDemo">
    <p>A missing src fires an error: the image drops out and the initial returns.</p>
  </Component>
  <Component heading="Group with count" Demo={<AvatarGroupDemo />} code="AvatarGroupDemo">
    <p>The group overlaps its members and closes with a count chip.</p>
  </Component>

  <AvatarContent />
</MainLayout>
