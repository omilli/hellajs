---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ButtonContent from "@ui/concepts/button.mdx";
import Component from "../../components/Component.astro";

import {
  ButtonVariants,
  ButtonSizes,
  ButtonRounded,
  ButtonIcon,
  ButtonWithIcon
} from "../../demos/button-demo"

const title = "Button";
const description = "Interactive Button demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Button</h1>
  <p>An interactive trigger: six variants, eight sizes, an aria-invalid state, and onclick wiring through dom's delegated event system.</p>

  <InstallSection entry="button" />

  <Component type="row" heading="Variants" Demo={<ButtonVariants/>} code="ButtonVariants"/>
  <Component type="row" heading="Sizes" Demo={<ButtonSizes/>} code="ButtonSizes"/>
  <Component type="row" heading="Icon" Demo={<ButtonIcon/>} code="ButtonIcon"/>
  <Component type="row" heading="With Icon" Demo={<ButtonWithIcon/>} code="ButtonWithIcon"/>
  <Component type="row" heading="Rounded" Demo={<ButtonRounded/>} code="ButtonRounded"/>

  <ButtonContent />
</MainLayout>
