---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import TextareaContent from "@ui/concepts/textarea.mdx";
import Component from "../../components/Component.astro";

import { TextareaDemo, TextareaInvalidDemo } from "../../demos/textarea-demo";

const title = "Textarea";
const description = "Interactive Textarea demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Textarea</h1>
  <p>A multi-line text input: the semantic textarea element with auto-sizing via field-sizing: content, and the same focus, disabled, and invalid treatments as Input.</p>

  <InstallSection entry="textarea" />

  <Component heading="Playground" Demo={<TextareaDemo />} code="TextareaDemo"/>
  <Component heading="Invalid state" Demo={<TextareaInvalidDemo />} code="TextareaInvalidDemo">
    <p>ariaInvalid recolors the border and, once focused, the ring, matching Input.</p>
  </Component>

  <TextareaContent />
</MainLayout>
