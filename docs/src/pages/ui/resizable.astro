---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ResizableContent from "@ui/concepts/resizable.mdx";
import Component from "../../components/Component.astro";

import { ResizableDemo, ResizableClampedDemo } from "../../demos/resizable-demo";

const title = "Resizable";
const description = "Interactive Resizable demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Resizable</h1>
  <p>Flex panels with drag handles: a group div lays panels out in a row or column, each handle moves the boundary between its two neighboring panels, and the sizes live in a percentage signal on the group.</p>

  <InstallSection entry="resizable" />

  <Component heading="Playground" Demo={<ResizableDemo client:load />} code="ResizableDemo"/>
  <Component heading="Clamped panels" Demo={<ResizableClampedDemo client:load />} code="ResizableClampedDemo">
    <p>The first panel clamps between 25 and 75 percent: a drag that runs out of room stops at the boundary instead of pushing the other panel.</p>
  </Component>

  <ResizableContent />
</MainLayout>
