---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import ResizableContent from "@ui/concepts/resizable.mdx";
import ResizableDemo, { ResizableClampedDemo } from "../../demos/resizable-demo";
import demoSource from "../../demos/resizable-demo.tsx?raw";
import { demoCode } from "../../utils/demo-code";

const title = "Resizable";
const description = "Interactive Resizable demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }}>
  <h1>Resizable</h1>
  <p>Flex panels with drag handles: a group div lays panels out in a row or column, each handle moves the boundary between its two neighboring panels, and the sizes live in a percentage signal on the group.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "ResizableDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <ResizableDemo client:load />
  </Demo>
  <InstallSection entry="resizable" />
  <ResizableContent />
  <h2>Examples</h2>
  <Demo id="demo-clamped" title="Clamped panels" code={demoCode(demoSource, "ResizableClampedDemo")} note="The first panel clamps between 25 and 75 percent: a drag that runs out of room stops at the boundary instead of pushing the other panel.">
    <ResizableClampedDemo client:load />
  </Demo>
</MainLayout>
