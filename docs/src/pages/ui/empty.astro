---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import EmptyContentPage from "@ui/concepts/empty.mdx";

const title = "Empty";
const description = "Interactive Empty demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const plainMediaCode = `<Empty>
  <EmptyHeader>
    <EmptyMedia class="text-muted-foreground [&>svg]:size-10">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0" /><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326" /></svg>
    </EmptyMedia>
    <EmptyTitle>No notifications</EmptyTitle>
  </EmptyHeader>
  <EmptyContent>You are all caught up.</EmptyContent>
</Empty>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Empty</h1>
  <p>An empty-state surface composed of a root plus header, media, title, description, and content parts, each carrying its data-slot and composable in any arrangement.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="empty" />
  <EmptyContentPage />
  <h2>Examples</h2>
  <Demo id="demo-plain-media" title="Plain media" code={plainMediaCode} note="Without the icon variant the media wrapper stays bare for illustrations and avatars." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Empty, { EmptyContent, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from "../../components/ui/empty";
  import "../../components/ui/tokens.js";

  const searchIcon = html`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>`;

  mount(html`<${Empty}>
    <${EmptyHeader}>
      <${EmptyMedia} variant="icon">${searchIcon}</${EmptyMedia}>
      <${EmptyTitle}>No results found</${EmptyTitle}>
      <${EmptyDescription}>Try a different keyword or clear your filters.</${EmptyDescription}>
    </${EmptyHeader}>
    <${EmptyContent}>
      <p>Queries match against file names and contents.</p>
    </${EmptyContent}>
  </${Empty}>`, document.getElementById("demo")!);

  const bellIcon = html`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg>`;

  mount(html`<${Empty}>
    <${EmptyHeader}>
      <${EmptyMedia} class="text-muted-foreground [&>svg]:size-10">${bellIcon}</${EmptyMedia}>
      <${EmptyTitle}>No notifications</${EmptyTitle}>
    </${EmptyHeader}>
    <${EmptyContent}>You are all caught up.</${EmptyContent}>
  </${Empty}>`, document.getElementById("demo-plain-media")!);
</script>
