---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import EmptyContent from "@ui/concepts/empty.mdx";
import Component from "../../components/Component.astro";

import { EmptyDemo, EmptyPlainMediaDemo } from "../../demos/empty-demo";

const title = "Empty";
const description = "Interactive Empty demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Empty</h1>
  <p>An empty-state surface composed of a root plus header, media, title, description, and content parts, each carrying its data-slot and composable in any arrangement.</p>

  <InstallSection entry="empty" />

  <Component heading="Playground" Demo={<EmptyDemo />} code="EmptyDemo"/>
  <Component heading="Plain media" Demo={<EmptyPlainMediaDemo />} code="EmptyPlainMediaDemo">
    <p>Without the icon variant the media wrapper stays bare for illustrations and avatars.</p>
  </Component>

  <EmptyContent />
</MainLayout>
