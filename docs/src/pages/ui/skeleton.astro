---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import SkeletonContent from "@ui/concepts/skeleton.mdx";

const title = "Skeleton";
const description = "Interactive Skeleton demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const blockCode = `<Skeleton class="h-32 w-full" />`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Skeleton</h1>
  <p>A loading placeholder: one div with the muted accent surface and a slow pulse animation, sized entirely through your own classes.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="skeleton" />
  <SkeletonContent />
  <h2>Examples</h2>
  <Demo id="demo-block" title="Block placeholder" code={blockCode} note="The element has no intrinsic size: height and width come from the call site." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Skeleton from "../../components/ui/skeleton";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <div class="flex items-center gap-4">
      <${Skeleton} class="size-12 rounded-full" />
      <div class="flex flex-col gap-2">
        <${Skeleton} class="h-4 w-32" />
        <${Skeleton} class="h-4 w-24" />
      </div>
    </div>
    <div class="flex flex-col gap-2">
      <${Skeleton} class="h-4 w-full" />
      <${Skeleton} class="h-4 w-full" />
      <${Skeleton} class="h-4 w-2/3" />
    </div>
  </div>`, document.getElementById("demo")!);

  mount(html`<${Skeleton} class="h-32 w-full" />`, document.getElementById("demo-block")!);
</script>
