---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import SkeletonContent from "@ui/concepts/skeleton.mdx";
import Component from "../../components/Component.astro";

import { SkeletonDemo, SkeletonBlockDemo } from "../../demos/skeleton-demo";

const title = "Skeleton";
const description = "Interactive Skeleton demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Skeleton</h1>
  <p>A loading placeholder: one div with the muted accent surface and a slow pulse animation, sized entirely through your own classes.</p>

  <InstallSection entry="skeleton" />

  <Component heading="Playground" Demo={<SkeletonDemo />} code="SkeletonDemo"/>
  <Component heading="Block placeholder" Demo={<SkeletonBlockDemo />} code="SkeletonBlockDemo">
    <p>The element has no intrinsic size: height and width come from the call site.</p>
  </Component>

  <SkeletonContent />
</MainLayout>
