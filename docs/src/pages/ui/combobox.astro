---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import ComboboxContent from "@ui/concepts/combobox.mdx";
import Component from "../../components/Component.astro";

import { ComboboxDemo, ComboboxMultipleDemo } from "../../demos/combobox-demo";

const title = "Combobox";
const description = "Interactive Combobox demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Combobox</h1>
  <p>A filterable listbox: the input owns a query signal, the panel anchors to the input wrapper, and typing narrows the options case-insensitively; Enter commits the active option, and multiple mode toggles values into removable chips.</p>

  <InstallSection entry="combobox" />

  <Component type="row" heading="Playground" Demo={<ComboboxDemo client:load />} code="ComboboxDemo">
    <p>Typing narrows the options case-insensitively while they hide in place; arrows move the active option and Enter commits it, closing the panel and clearing the query.</p>
  </Component>
  <Component type="row" heading="Multiple selection" Demo={<ComboboxMultipleDemo client:load />} code="ComboboxMultipleDemo">
    <p>Enter toggles the active value in or out of the array and the panel stays open; each selection renders as a removable chip, and the clear affordance wipes the whole selection.</p>
  </Component>

  <ComboboxContent />
</MainLayout>
