---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import LabelContent from "@ui/concepts/label.mdx";
import LabelDemo, { LabelDisabledDemo } from "../../demos/label-demo";
import demoSource from "../../demos/label-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/label.css", "utf8");

const title = "Label";
const description = "Interactive Label demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Label</h1>
  <p>A form-field caption: the semantic label element with a for passthrough, plus group- and peer-driven disabled styles.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "LabelDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <LabelDemo client:load />
  </Demo>
  <InstallSection entry="label" />
  <LabelContent />
  <h2>Examples</h2>
  <Demo id="demo-disabled" title="Disabled group" code={demoCode(demoSource, "LabelDisabledDemo")} note="Inside .group[data-disabled=true] the caption dims and drops pointer events; no props needed.">
    <LabelDisabledDemo client:load />
  </Demo>
</MainLayout>
