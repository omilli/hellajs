---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import LabelContent from "@ui/concepts/label.mdx";

const title = "Label";
const description = "Interactive Label demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const disabledGroupCode = `<div class="group flex flex-col gap-2" data-disabled="true">
  <Label for="demo-region">Region</Label>
  <input id="demo-region" value="eu-central-1" disabled />
</div>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Label</h1>
  <p>A form-field caption: the semantic label element with a for passthrough, plus group- and peer-driven disabled styles.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="label" />
  <LabelContent />
  <h2>Examples</h2>
  <Demo id="demo-disabled" title="Disabled group" code={disabledGroupCode} note="Inside .group[data-disabled=true] the caption dims and drops pointer events; no props needed." />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Label from "../../components/ui/label";
  import "../../components/ui/tokens.js";

  mount(html`<div class="flex flex-col gap-2">
    <${Label} for="demo-name">Project name</${Label}>
    <input id="demo-name" placeholder="acme-site" class="flex h-9 w-full max-w-xs rounded-md border border-input bg-transparent px-3 text-sm" />
  </div>`, document.getElementById("demo")!);

  mount(html`<div class="group flex flex-col gap-2" data-disabled="true">
    <${Label} for="demo-region">Region</${Label}>
    <input id="demo-region" value="eu-central-1" disabled class="flex h-9 w-full max-w-xs rounded-md border border-input bg-transparent px-3 text-sm opacity-50" />
  </div>`, document.getElementById("demo-disabled")!);
</script>
