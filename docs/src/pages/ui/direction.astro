---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import DirectionContent from "@ui/concepts/direction.mdx";
import DirectionDemo, { DirectionNestedDemo } from "../../demos/direction-demo";
import demoSource from "../../demos/direction-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/direction.css", "utf8");

const title = "Direction";
const description = "Interactive Direction demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Direction</h1>
  <p>A text-direction wrapper: it renders a dir attribute on a layout-neutral node, and that attribute is the mechanism every directional behavior reads.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "DirectionDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <DirectionDemo client:load />
  </Demo>
  <InstallSection entry="direction" />
  <DirectionContent />
  <h2>Examples</h2>
  <Demo id="demo-nested" title="Nested providers" code={demoCode(demoSource, "DirectionNestedDemo")} note="Each wrapper scopes its own dir attribute, so a subtree can flip against its parent.">
    <DirectionNestedDemo client:load />
  </Demo>
</MainLayout>
