---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import KbdContent from "@ui/concepts/kbd.mdx";

const title = "Kbd";
const description = "Interactive Kbd demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";

const groupCode = `<div class="flex flex-col gap-2 text-sm">
  <KbdGroup>
    <Kbd>ctrl</Kbd>
    <Kbd>shift</Kbd>
    <Kbd>P</Kbd>
  </KbdGroup>
  <KbdGroup>
    <Kbd>⌘</Kbd>
    <Kbd>B</Kbd>
  </KbdGroup>
</div>`;
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Kbd</h1>
  <p>A keyboard-key chip: a Kbd element for single keys and a KbdGroup for sequences, both rendering the semantic kbd tag.</p>
  <div class="demo-frame dark" id="demo"></div>
  <InstallSection entry="kbd" />
  <KbdContent />
  <h2>Examples</h2>
  <Demo id="demo-group" title="Grouped sequences" code={groupCode} />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Kbd, { KbdGroup } from "../../components/ui/kbd";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <div class="demo-row items-center text-sm">
      Save changes <${Kbd}>⌘S</${Kbd}>
    </div>
    <div class="demo-row items-center text-sm">
      Dismiss <${Kbd}>esc</${Kbd}>
    </div>
  </div>`, document.getElementById("demo")!);

  mount(html`<div class="demo-stack">
    <${KbdGroup}>
      <${Kbd}>ctrl</${Kbd}>
      <${Kbd}>shift</${Kbd}>
      <${Kbd}>P</${Kbd}>
    </${KbdGroup}>
    <${KbdGroup}>
      <${Kbd}>⌘</${Kbd}>
      <${Kbd}>B</${Kbd}>
    </${KbdGroup}>
  </div>`, document.getElementById("demo-group")!);
</script>
