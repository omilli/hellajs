---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import Demo from "../../components/Demo.astro";
import KbdContent from "@ui/concepts/kbd.mdx";
import KbdDemo, { KbdGroupDemo } from "../../demos/kbd-demo";
import demoSource from "../../demos/kbd-demo.tsx?raw";
import { readFileSync } from "node:fs";
import { demoCode } from "../../utils/demo-code";

const demoCss = readFileSync("src/generated/pagecss/kbd.css", "utf8");

const title = "Kbd";
const description = "Interactive Kbd demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";

---

<MainLayout frontmatter={{ title, description }} demoCss={demoCss}>
  <h1>Kbd</h1>
  <p>A keyboard-key chip: a Kbd element for single keys and a KbdGroup for sequences, both rendering the semantic kbd tag.</p>
  <Demo id="demo" title="Playground" code={demoCode(demoSource, "KbdDemo", { withImports: true })} note="View Code shows the playground's imports and the exact component this demo runs.">
    <KbdDemo client:load />
  </Demo>
  <InstallSection entry="kbd" />
  <KbdContent />
  <h2>Examples</h2>
  <Demo id="demo-group" title="Grouped sequences" code={demoCode(demoSource, "KbdGroupDemo")}>
    <KbdGroupDemo client:load />
  </Demo>
</MainLayout>
