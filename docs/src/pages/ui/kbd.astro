---
import MainLayout from "../../layouts/MainLayout.astro";
import KbdContent from "@ui/concepts/kbd.mdx";

const title = "Kbd";
const description = "Interactive Kbd demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <KbdContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import Kbd, { KbdGroup } from "../../components/ui/kbd";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <div class="demo-row items-center text-sm">
      Save changes <${Kbd}>⌘S</${Kbd}>
    </div>
    <div class="demo-row items-center text-sm">
      Open the command palette
      <${KbdGroup}>
        <${Kbd}>ctrl</${Kbd}>
        <${Kbd}>shift</${Kbd}>
        <${Kbd}>P</${Kbd}>
      </${KbdGroup}>
    </div>
    <div class="demo-row items-center text-sm">
      Toggle sidebar <${Kbd}>⌘</${Kbd}><${Kbd}>B</${Kbd}>
    </div>
  </div>`, document.getElementById("demo")!);
</script>
