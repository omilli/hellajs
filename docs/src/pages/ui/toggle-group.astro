---
import MainLayout from "../../layouts/MainLayout.astro";
import ToggleGroupContent from "@ui/concepts/toggle-group.mdx";

const title = "Toggle Group";
const description = "Interactive Toggle Group demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <ToggleGroupContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import ToggleGroup from "../../components/ui/toggle-group";
  import "../../components/ui/tokens.js";

  const view = signal("week");
  const formats = signal(["bold"]);
  mount(html`<div class="demo-stack">
    <${ToggleGroup}
      type="single"
      items=${[
        { value: "day", label: "Day" },
        { value: "week", label: "Week" },
        { value: "month", label: "Month" },
      ]}
      value=${() => view()}
      onValueChange=${(next: string) => view(next)}
    />
    <p class="demo-note">View: ${() => view() || "none"}</p>
    <${ToggleGroup}
      type="multiple"
      variant="outline"
      items=${[
        { value: "bold", label: "B" },
        { value: "italic", label: "I" },
        { value: "underline", label: "U" },
      ]}
      values=${() => formats()}
      onValueChange=${(next: string[]) => formats(next)}
    />
    <p class="demo-note">Formats: ${() => formats().join(", ") || "none"}</p>
  </div>`, document.getElementById("demo")!);
</script>
