---
import MainLayout from "../../layouts/MainLayout.astro";
import InstallSection from "../../components/InstallSection.astro";
import BadgeContent from "@ui/concepts/badge.mdx";
import Component from "../../components/Component.astro";

import { BadgeDemo, BadgeAnchorDemo } from "../../demos/badge-demo";

const title = "Badge";
const description = "Interactive Badge demo running the site's built registry source via an Astro island, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>Badge</h1>
  <p>A small status descriptor: six variants, an aria-invalid state, and anchor-aware hover styles.</p>

  <InstallSection entry="badge" />

  <Component type="row" heading="Playground" Demo={<BadgeDemo />} code="BadgeDemo"/>
  <Component heading="Anchor hover" Demo={<BadgeAnchorDemo />} code="BadgeAnchorDemo">
    <p>Inside an anchor the hover styles activate: outline picks up the accent surface.</p>
  </Component>

  <BadgeContent />
</MainLayout>
