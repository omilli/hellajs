---
import MainLayout from "../../layouts/MainLayout.astro";
import AspectRatioContent from "@ui/concepts/aspect-ratio.mdx";

const title = "Aspect Ratio";
const description = "Interactive AspectRatio demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <AspectRatioContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import AspectRatio from "../../components/ui/aspect-ratio";
  import "../../components/ui/tokens.js";

  mount(html`<div class="demo-stack">
    <${AspectRatio} ratio=${16 / 9} class="bg-muted rounded-lg overflow-hidden">
      <div class="flex size-full items-center justify-center text-sm text-muted-foreground">16 / 9</div>
    </${AspectRatio}>
    <div class="flex gap-3">
      <${AspectRatio} ratio=${1} class="w-32 bg-muted rounded-lg overflow-hidden">
        <div class="flex size-full items-center justify-center text-sm text-muted-foreground">1 / 1</div>
      </${AspectRatio}>
      <${AspectRatio} ratio=${4 / 3} class="flex-1 bg-muted rounded-lg overflow-hidden">
        <div class="flex size-full items-center justify-center text-sm text-muted-foreground">4 / 3</div>
      </${AspectRatio}>
    </div>
  </div>`, document.getElementById("demo")!);
</script>
