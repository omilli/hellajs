---
import MainLayout from "../../layouts/MainLayout.astro";
import SheetContent from "@ui/concepts/sheet.mdx";

const title = "Sheet";
const description = "Interactive Sheet demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <SheetContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import Button from "../../components/ui/button";
  import Sheet from "../../components/ui/sheet";
  import "../../components/ui/tokens.js";

  const open = signal(false);
  mount(html`<div class="demo-stack">
    <${Button} variant="outline" onclick=${() => open(true)}>Open right sheet</${Button}>
    <p class="demo-note">Slides in from the right with wired title and description, an X close button, escape and outside dismissal, and a focus trap.</p>
    <${Sheet} open=${open} onClose=${() => open(false)} side="right" title="Edit profile" description="Make changes to your profile here. Click save when you're done.">
      <p>This panel slides in from the right edge with its geometry and slide variant from the side table.</p>
      <${Button} onclick=${() => open(false)}>Save changes</${Button}>
    </${Sheet}>
  </div>`, document.getElementById("demo")!);
</script>
