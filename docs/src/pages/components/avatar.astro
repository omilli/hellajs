---
import MainLayout from "../../layouts/MainLayout.astro";
import AvatarContent from "@ui/concepts/avatar.mdx";

const title = "Avatar";
const description = "Interactive Avatar demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <AvatarContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import Avatar, { AvatarBadge, AvatarFallback, AvatarGroup, AvatarGroupCount, AvatarImage } from "../../components/ui/avatar";
  import "../../components/ui/tokens.js";

  // A missing src fires `error`: the image drops out and the initial returns.
  const loaded = signal(false);
  mount(html`<div class="demo-stack">
    <div class="flex items-center gap-3">
      <${Avatar}>
        <${AvatarImage} src="/missing-avatar.png" alt="Broken image" loaded=${loaded} />
        <${AvatarFallback} loaded=${loaded}>M</${AvatarFallback}>
      </${Avatar}>
      <${Avatar} size="lg">
        <${AvatarFallback}>M</${AvatarFallback}>
        <${AvatarBadge} />
      </${Avatar}>
      <${Avatar} size="sm"><${AvatarFallback}>M</${AvatarFallback}></${Avatar}>
    </div>
    <${AvatarGroup}>
      <${Avatar}><${AvatarFallback}>M</${AvatarFallback}></${Avatar}>
      <${Avatar}><${AvatarFallback}>J</${AvatarFallback}></${Avatar}>
      <${Avatar}><${AvatarFallback}>A</${AvatarFallback}></${Avatar}>
      <${AvatarGroupCount}>+5</${AvatarGroupCount}>
    </${AvatarGroup}>
  </div>`, document.getElementById("demo")!);
</script>
