---
import MainLayout from "../../layouts/MainLayout.astro";
import ItemContent from "@ui/concepts/item.mdx";

const title = "Item";
const description = "Interactive Item demo running the CLI-vendored css-flavor source the same `add` command installs, with install and per-style usage from the package docs.";
---

<MainLayout frontmatter={{ title, description }}>
  <div class="demo-frame dark" id="demo"></div>
  <ItemContent />
</MainLayout>

<script>
  import { html, mount } from "@hellajs/dom";
  import { signal } from "@hellajs/core";
  import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "../../components/ui/item";
  import Button from "../../components/ui/button";
  import "../../components/ui/tokens.js";

  const selected = signal("archive");
  const row = (id, title, copy) => html`<${Item} onclick="${() => selected(id)}" selected=${() => selected() === id}>
    <${ItemMedia} variant="icon">${id[0].toUpperCase()}</${ItemMedia}>
    <${ItemContent}>
      <${ItemTitle}>${title}</${ItemTitle}>
      <${ItemDescription}>${copy}</${ItemDescription}>
    </${ItemContent}>
    <${ItemActions}><${Button} size="sm" variant="outline">Run</${Button}></${ItemActions}>
  </${Item}>`;
  mount(html`<div class="demo-stack">
    <${ItemGroup}>
      ${() => row("archive", "Archive", "Move the report to long-term storage.")}
      <${ItemSeparator} />
      ${() => row("export", "Export", "Download a CSV of every entry.")}
      <${ItemSeparator} />
      ${() => row("share", "Share", "Invite two teammates to collaborate.")}
    </${ItemGroup}>
    <p style="text-align:center">Click a row; selection drives data-selected and aria-selected.</p>
  </div>`, document.getElementById("demo")!);
</script>
