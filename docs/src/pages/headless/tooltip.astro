---
import MainLayout from "../../layouts/MainLayout.astro";
import DemoFrame from "../../components/DemoFrame.astro";
import { TooltipDemo } from "../../demos/headless/tooltip-demo";
import TooltipContent from "@headless/api/tooltip.mdx";

const title = "tooltip";
const description = "Creates the tooltip parts in one factory call: provider grouping slot, hover trigger, and the ported anchored label.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>tooltip</h1>
  <DemoFrame code="TooltipDemo">
    <TooltipDemo client:load />
  </DemoFrame>
  <TooltipContent />
</MainLayout>
