---
import MainLayout from "../../layouts/MainLayout.astro";
import DemoFrame from "../../components/DemoFrame.astro";
import { OnEscapeDemo } from "../../demos/headless/onescape-demo";
import OnescapeContent from "@headless/api/onescape.mdx";

const title = "onEscape";
const description = "Calls a handler when an Escape keydown fires on a target.";
---

<MainLayout frontmatter={{ title, description }}>
  <h1>onEscape</h1>
  <DemoFrame code="OnEscapeDemo">
    <OnEscapeDemo client:load />
  </DemoFrame>
  <OnescapeContent />
</MainLayout>
