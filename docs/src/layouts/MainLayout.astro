---
import Navbar from "../components/Navbar.astro";
import DocsNav from "../components/DocsNav.astro";
import SearchPalette from "../components/SearchPalette";
import Toc from "../components/Toc.astro";
import {tocRegex} from "../utils/toc-regex";
import { css, cssText } from "@hellajs/css";
import { tokens } from "../styles/tokens";
import "../styles/preflight";
import "../styles/menu";
import "../styles/fonts";
import "../styles/global";
import "../styles/prose";

css({
  // Content column: clear the fixed navbar, the left rail on desktop, and
  // the right rail when the page has one (has-toc set server-side by the
  // layout from the extracted TOC length).
  ".site-main": {
    paddingTop: tokens.navbarH,
    "&.has-toc": {
      "@media (min-width: 64rem)": {
        "&": { marginRight: tokens.tocW },
      },
    },
    "& > main": {
      padding: "1rem",
      "@media (min-width: 64rem)": {
        "&": { padding: "2rem" },
      },
    },
    "@media (min-width: 64rem)": {
      "&": { marginLeft: tokens.navW },
    },
  },

  // Mobile drawer overlay: follows the checkbox like the nav; desktop
  // never shows it (the rail is static there). The checkbox state is the
  // subject (the compiler substitutes only a LEADING `&`), so the sibling
  // rules sit at the top level.
  ".nav-overlay": {
    background: "rgb(0 0 0 / 60%)",
    display: "none",
    inset: "0",
    position: "fixed",
    zIndex: "30",
    "@media (min-width: 64rem)": {
      "&": { display: "none" },
    },
  },
  "#nav-drawer:checked ~ .nav-overlay": { display: "block" },
  "@media (min-width: 64rem)": {
    "#nav-drawer:checked ~ .nav-overlay": { display: "none" },
  },
});

const { frontmatter = {}, title: pageTitle } = Astro.props;
const title = frontmatter.title || pageTitle;
// Adoptable split: the ids let hydration claim the delivered rules against
// client re-registrations instead of re-injecting them (no duplicated rules,
// no flash window). css side first — the client's `hella-css` sheet always
// precedes `hella-vars`.

// "On This Page" is server-rendered (site-foundation set contract: no
// client render, zero flash). Render the slot to its final HTML first —
// wrapper pages import their content as components, so Astro's headings
// prop cannot see those headings — and lift the h2/h3 out of it. Ids come
// from the mdx pipeline's own slugs (no slugger replication); headings
// without an id are not linkable and are skipped.
const content = await Astro.slots.render("default");
const toc: { text: string; slug: string; depth: number }[] = Array.from(
  content.matchAll(tocRegex),
  (m) => ({
    depth: Number(m[1]),
    slug: m[2],
    text: m[3].replace(/<[^>]+>/g, "").trim(),
  }),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HellaJS</title>
    <style
      id="hella-css"
      is:inline
      set:html={cssText.css()}
    />
    {cssText.vars() && <style id="hella-vars" is:inline set:html={cssText.vars()} />}
  </head>
  <body class="dark">
    <!-- body.dark carries the registry default dark palette; this wrapper
         rescopes the site palette over chrome/prose (see
         ../styles/tokens.ts). Portals appended to body escape the wrapper
         and keep the registry default. Drawer state: checked = open. Sits
         before every drawer surface so the sibling selectors
         (`#nav-drawer:checked ~ …`, owned by DocsNav and below) reach them;
         Navbar's hamburger label toggles it — zero client JS. -->
    <div class="docs-palette">
      <input id="nav-drawer" type="checkbox" hidden />
      <Navbar />
      <Toc entries={toc} variant="mobile" />
      <label for="nav-drawer" class="nav-overlay" aria-label="Close navigation"></label>
      <DocsNav pathname={Astro.url.pathname} />
      <div class:list={["site-main", toc.length > 0 && "has-toc"]}>
        <main set:html={content} />
      </div>
      <Toc entries={toc} variant="rail" />
      <!-- Search palette: renders nothing until the trigger or ⌘K opens it;
           its styles register client-side with its module. -->
      <SearchPalette client:load />
    </div>
  </body>
</html>
