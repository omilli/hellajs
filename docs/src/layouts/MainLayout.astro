---
import Navbar from "../chrome/Navbar.astro";
import DocsNav from "../chrome/DocsNav.astro";
import SearchPalette from "../chrome/SearchPalette";
import Toc from "../chrome/Toc.astro";
import { cssText } from "@hellajs/css";
import "../styles/preflight";
import "../styles/global";
import "../styles/prose";
import "../chrome/chrome-css";
import "../global.css";
const { frontmatter = {}, title: pageTitle, demoCss } = Astro.props;
const title = frontmatter.title || pageTitle;

// "On This Page" is server-rendered (site-foundation set contract: no
// client render, zero flash). Render the slot to its final HTML first —
// wrapper pages import their content as components, so Astro's headings
// prop cannot see those headings — and lift the h2/h3 out of it. Ids come
// from the mdx pipeline's own slugs (no slugger replication); headings
// without an id are not linkable and are skipped.
const content = await Astro.slots.render("default");
const toc: { text: string; slug: string; depth: number }[] = Array.from(
  content.matchAll(/<h([23])[^>]*?\sid="([^"]*)"[^>]*>([\s\S]*?)<\/h\1>/g),
  (m) => ({
    depth: Number(m[1]),
    slug: m[2],
    text: m[3].replace(/<[^>]+>/g, "").trim(),
  }),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HellaJS</title>
    <!-- id="site-head", NOT "hella-css": the css runtime adopts and DRAINS
         any #hella-css tag at first client registration (packages/css/lib/
         internal/sheet.ts, adoptElementRules) — on pages whose first-registering
         island is a demo island, the drain stripped this SSR text until the
         site css re-registered, flashing an unstyled window. Under a foreign
         id the runtime creates its own sheet alongside; registry styles
         re-register there post-hydration (byte-identical rules, zero visual
         difference) and this tag is never touched. The leading `@layer base,`
         `hella;` statement pins the cascade-layer order (preflight port <
         registry < unlayered site CSS) ahead of everything else — the
         tailwind layer list it replaced died with the utility exit. -->
    <style
      id="site-head"
      is:inline
      set:html={(demoCss ?? "") + cssText()}
    />
  </head>
  <body>
    <!-- Drawer state: checked = open. Sits before every drawer surface so
         chrome-css's sibling selectors (`#nav-drawer:checked ~ …`) reach
         them; Navbar's hamburger label toggles it — zero client JS. -->
    <input id="nav-drawer" type="checkbox" hidden />
    <Navbar />
    <Toc entries={toc} variant="mobile" />
    <label for="nav-drawer" class="nav-overlay" aria-label="Close navigation"></label>
    <DocsNav pathname={Astro.url.pathname} />
    <div class:list={["site-main", toc.length > 0 && "has-toc"]}>
      <main set:html={content} />
    </div>
    <Toc entries={toc} variant="rail" />
    <!-- Search palette (unit 10): renders nothing until the trigger or
         ⌘K opens it; its styles register client-side with its module. -->
    <SearchPalette client:load />
  </body>
</html>
