---
import { cssText } from "@hellajs/css";
import "../styles/prose";
import "../chrome/chrome-css";
import "../styles/tokens";
import "../global.css";

const { frontmatter = {}, title: pageTitle } = Astro.props;
const title = frontmatter.title || pageTitle;
const description =
  frontmatter.description ||
  "A reactive JavaScript framework for building fast, lightweight user interfaces with JSX.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | HellaJS`} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | HellaJS`} />
    <meta property="twitter:description" content={description} />

    <title>{title} | HellaJS</title>
    <!-- Same mechanism as MainLayout's site-head tag. The css registry is
         global to the build process, so whatever the layout imports itself
         is what cssText() deterministically contains — the same module set
         as MainLayout (minus demoCss) keeps this page's head identical in
         shape no matter which page the build rendered before it. -->
    <style id="site-head" is:inline set:html={"@layer base, hella;\n" + cssText()} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
