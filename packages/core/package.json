{
  "name": "@hellajs/core",
  "version": "1.0.11",
  "homepage": "https://github.com/omilli/hellajs.git",
  "bugs": {
    "url": "https://github.com/omilli/hellajs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omilli/hellajs.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
