{
  "name": "@hellajs/css",
  "version": "1.1.1",
  "homepage": "git+https://github.com/omilli/hellajs.git",
  "bugs": {
    "url": "https://github.com/omilli/hellajs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/omilli/hellajs.git",
    "directory": "packages/css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "peerDependencies": {
    "@hellajs/core": "^1.0.6"
  }
}
