{
  "name": "@hellajs/ssr",
  "version": "1.0.0",
  "description": "Reactive HTML stringifier — walks a HellaNode AST to an HTML string with zero runtime dependencies.",
  "homepage": "git+https://github.com/omilli/hellajs.git",
  "bugs": {
    "url": "https://github.com/omilli/hellajs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/omilli/hellajs.git",
    "directory": "packages/ssr"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@hellajs/dom": "^1.4.2"
  }
}
