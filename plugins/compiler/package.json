      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "acorn": "^8.14.0",
    "acorn-jsx": "^5.3.2",
    "astring": "^1.9.0",
    "oxc-transform": "^0.155.0"
  },
  "devDependencies": {
    "@hellajs/dom": "*"
  }
}
